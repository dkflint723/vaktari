<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fs="clr-namespace:Vaktari.Core.FileSystem;assembly=Vaktari.Core"
        xmlns:vm="clr-namespace:Vaktari.Ui.ViewModels"
        xmlns:core="clr-namespace:Vaktari.Core;assembly=Vaktari.Core"
        xmlns:th="clr-namespace:Vaktari.Ui.Thumbnails"
        xmlns:local="clr-namespace:Vaktari.Ui"
        xmlns:sh="clr-namespace:Vaktari.Core.Sharing;assembly=Vaktari.Core"
        xmlns:pl="clr-namespace:Vaktari.Core.Places;assembly=Vaktari.Core"
        x:Class="Vaktari.Ui.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Vaktari"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource ViewText}"
        FontFamily="{DynamicResource AppFontFamily}"
        Width="1000" Height="680">

  <Window.Styles>

    <!-- **A TextBox that is only its text.**
         Fluent gives a TextBox its own filled background, and swaps it for a
         DIFFERENT fill while focused. Setting Background="Transparent" on the
         control does not stop that: the theme's :focus and :pointerover styles
         set the background on the template's own Border#PART_BorderElement,
         which is a different property on a different object, so the local value
         has nothing to override.

         The symptom was a black rectangle appearing inside the rounded search
         field the moment anyone typed in it, and only then — the field looked
         correct until it had focus.

         Every state is listed rather than relying on style order, because the
         one that broke was a state the base selector already appeared to
         cover. The rounded fill and border belong to the Border wrapping the
         field; the TextBox inside is meant to contribute nothing but glyphs. -->
    <Style Selector="TextBox.flat /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.flat:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.flat:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- **A disabled button was the only one with a background.**
         The same Fluent behaviour as above, in its most visible form: the
         :disabled style fills PART_ContentPresenter with ButtonBackgroundDisabled,
         which against this flat dark chrome is a light grey slab. So with no
         history to go forward to, "forward" and "up" were the two buttons
         wearing a raised fill while "back" — the one that actually worked —
         stayed flat. Exactly backwards.

         Window-wide rather than per-button: every button in this window is
         flat by design, and the ones that can be disabled are scattered
         (navigation, scan, connect to server).

         The opacity is doing the work the fill used to. It has to be on the
         button rather than left to Fluent's foreground dimming, because these
         buttons are stroked Paths with an explicit Stroke — a Foreground
         setter never reaches them, which is why removing the fill would
         otherwise leave nothing at all to say "unavailable". -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.38"/>
    </Style>

  </Window.Styles>

  <Window.Resources>

    <!-- The type scale and every derived metric are deliberately NOT declared
         here. ApplyScales writes them into Application.Resources before the
         first paint, and a DynamicResource resolves from the nearest dictionary
         outward — so a copy in Window.Resources shadows the scaled value and
         the size never changes. That is exactly what happened: the font keys
         were declared here and text ignored the control entirely, while the
         keys that were absent (TileSize, TileWidth, TileHeight) responded,
         which made icon scaling look like it worked.

         Keys owned by ApplyScales: FontSizeTiny/Small/Base/Large, ThumbSize,
         IconSize, TileSize, RowHeight, TileWidth, TileHeight, RailWidth,
         ColumnStripHeight. Do not declare any of them in markup. -->

    <!-- Colours come from the desktop scheme at runtime (see ThemeApplier);
         nothing is hardcoded here. The rule they must satisfy is unchanged:
         hue never carries meaning on its own, so selection also gets an edge
         bar and file age is a lightness ramp. That is
         what makes adopting an arbitrary system theme safe. -->

    <!-- Both halves of a split render from this one template. The split is two
         instances of the same view, not a second code path — which is why
         PaneViewModel was built to own its own path, history and selection. -->
    <DataTemplate x:Key="PaneGroupTemplate" x:DataType="vm:PaneGroupViewModel">
      <!-- The group measures ITSELF, rather than the details panel's fit being
           derived from the listing's width. Deriving it was circular: the
           listing's width already excludes the panel when the panel is shown,
           and "is it shown" is the very thing being decided. -->
      <DockPanel SizeChanged="OnGroupSizeChanged">
      <!-- One panel per split side. Docked inside the group so it describes
           THIS side's selection — a single window-level panel kept swapping
           content as focus moved between halves, which defeats the point of
           comparing two folders side by side. -->
      <Border DockPanel.Dock="Right" IsVisible="{Binding IsInfoUsable}"
              Width="{Binding InfoWidth}"
              Background="{DynamicResource PanelBackground}"
              BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SeparatorColour}">
        <ScrollViewer>
          <StackPanel Margin="14" Spacing="10">

            <Border Height="200" CornerRadius="6"
                    Background="{DynamicResource ViewBackground}"
                    IsVisible="{Binding Info.HasSelection}">
              <Panel>
                <Image th:ThumbnailImage.Path="{Binding Info.PreviewPath}"
                       th:ThumbnailImage.Size="512"
                       IsVisible="{Binding !Info.IsFolder}"
                       Stretch="Uniform" Margin="8"/>
                <!-- TileSize, because this is standing in for an icon rather
                     than being text: it should follow the icon scale, and it was
                     the last size in the window pinned to a literal. -->
                <TextBlock Text="&#x1F4C1;" FontSize="{DynamicResource TileSize}"
                           IsVisible="{Binding Info.IsFolder}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ViewDimText}"/>
              </Panel>
            </Border>

            <TextBlock Text="{Binding Info.Name}" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeBase}" FontWeight="SemiBold"/>

            <!-- DockPanel, so the kind can actually trim. In a horizontal
                 StackPanel it is measured with infinite width and never told it
                 has run out of room, which makes CharacterEllipsis inert. -->
            <DockPanel>
              <TextBlock Text="{Binding Info.Summary}" DockPanel.Dock="Right"
                         Margin="8,0,0,0"
                         FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource ViewDimText}"/>
              <TextBlock Text="{Binding Info.Kind}"
                         FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Border Height="1" Background="{DynamicResource SeparatorColour}"
                    IsVisible="{Binding Info.HasSelection}"/>

            <ItemsControl ItemsSource="{Binding Info.Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="fs:PropertyRow">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Width="96"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ViewDimText}"
                               TextTrimming="CharacterEllipsis"/>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}"
                                         FontSize="{DynamicResource FontSizeSmall}"
                                         TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- **A 4px GridSplitter stood here and could not move anything.** A
           splitter resizes by editing the Row or ColumnDefinitions it sits
           between, and this group is a DockPanel, which has neither — the same
           trap the sidebar handle's comment at the foot of this file exists to
           explain. It drew a bar, showed a west-east resize cursor, and left
           the panel on whatever InfoWidth was last restored to; nothing else
           in the application writes that value.

           Replaced with the shape that does work, which is the sidebar's: a
           Thumb reports how far it was dragged and changes nothing itself, so
           the width is moved in the handler. Transparent for the same reason
           as the sidebar's — the panel's own left border is already the
           separator, and this is grab area with a cursor to announce it.

           DragDelta rather than x:Name and a constructor hook-up, because this
           markup is a template: in split view there are two of these, and a
           name would find one. The handler reads the group from the Thumb's
           DataContext, exactly as OnGroupSizeChanged does. -->
      <Thumb DockPanel.Dock="Right" Width="5"
             Background="Transparent" Cursor="SizeWestEast"
             IsVisible="{Binding IsInfoUsable}"
             DragDelta="OnInfoHandleDrag">
        <Thumb.Template>
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"/>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>


        <!-- The accent rides the top of the ACTIVE side's tab bar. With two
             identical listings side by side, which one takes the next keystroke
             cannot be a subtle cue. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Padding="8,7,8,0"
                BorderThickness="0,2,0,0"
                BorderBrush="{Binding IsActiveGroup, Converter={x:Static vm:FileConverters.ActiveEdge}}">
         <DockPanel>
          <DockPanel.Styles>
            <!-- The overflow chevrons. Flat and dim like the strip's own "+",
                 because they are furniture, not actions — until the tabs
                 overflow they do not exist at all, and the far end's chevron
                 dims when there is nothing further that way. -->
            <Style Selector="RepeatButton.tab-nudge">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Foreground" Value="{DynamicResource ViewDimText}"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
              <Setter Property="Padding" Value="7,0,7,4"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="VerticalContentAlignment" Value="Center"/>
              <Setter Property="Focusable" Value="False"/>
            </Style>
            <Style Selector="RepeatButton.tab-nudge:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            </Style>
            <Style Selector="RepeatButton.tab-nudge:disabled">
              <Setter Property="Opacity" Value="0.3"/>
            </Style>
          </DockPanel.Styles>
          <!-- Per-pane, so in a split each side toggles its own chain. Binds
               through this group's ActiveTab rather than the shell's, which
               would only ever be the focused half. -->
          <!-- One control for all three axes: layout, and the two sizes.
               They were previously spread across a toggle button and a pair of
               keyboard shortcuts, which made two of them undiscoverable. -->
          <!-- Layout is one click, per pane and per side. It was two clicks
               behind a menu, which is too far for something switched this often.

               These are docked RIGHT, so the first declared sits furthest right
               and declaration order is the reverse of what you see. Reading
               left to right on screen: list, small grid, large grid, then the
               details panel behind a rule.

               ToggleButton rather than RadioButton throughout: Fluent draws a
               RadioButton's selection circle BESIDE its content, so three
               layout buttons rendered as six glyphs and the row read as twice
               as many controls in no obvious order. A ToggleButton shows the
               same state as a background. They still behave as one choice
               because IsChecked is OneWay-bound to the view mode, so setting
               any of them re-evaluates all three — the three layouts are one choice,
               the panel is a different one, and the rule says so. -->

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center" Margin="0,0,0,6">

            <StackPanel.Styles>
              <Style Selector="ToggleButton.seg">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="MinWidth" Value="0"/>
              </Style>
              <!-- Fluent paints the checked state on the ContentPresenter, so
                   the tint has to be set there or the theme's solid accent wins
                   and the option reads as a button rather than a selection. -->
              <Style Selector="ToggleButton.seg /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="3"/>
              </Style>
              <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
              </Style>
              <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
              </Style>
              <Style Selector="ToggleButton.seg Path">
                <Setter Property="Fill" Value="{DynamicResource ViewDimText}"/>
              </Style>
              <Style Selector="ToggleButton.seg:checked Path">
                <Setter Property="Fill" Value="{DynamicResource AccentColour}"/>
              </Style>
              <!-- Stroked glyphs take the same colours on the other property. -->
              <Style Selector="ToggleButton.seg Path.stroke">
                <Setter Property="Fill" Value="Transparent"/>
                <Setter Property="Stroke" Value="{DynamicResource ViewDimText}"/>
              </Style>
              <Style Selector="ToggleButton.seg:checked Path.stroke">
                <Setter Property="Stroke" Value="{DynamicResource AccentColour}"/>
              </Style>
            </StackPanel.Styles>

            <!-- The three layouts are ONE choice, so they share one container
                 instead of being three loose buttons next to a rule.

                 ToggleButton rather than RadioButton throughout: Fluent draws a
                 RadioButton's selection circle BESIDE its content, so three
                 layout buttons rendered as six glyphs and the row read as twice
                 as many controls in no obvious order. A ToggleButton shows the
                 same state as a background. They still behave as one choice
                 because IsChecked is OneWay-bound to the view mode, so setting
                 any of them re-evaluates all three. -->
            <Border Background="{DynamicResource ChipBackground}" CornerRadius="4" Padding="2">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="seg"
                              IsChecked="{Binding ActiveTab.IsDetailsView, Mode=OneWay}"
                              Command="{Binding ActiveTab.ShowAsDetailsCommand}"
                              AutomationProperties.Name="list" ToolTip.Tip="list">
                  <Path Data="M0,0 H12 V2 H0 Z M0,5 H12 V7 H0 Z M0,10 H12 V12 H0 Z"
                        Width="12" Height="12" Stretch="Uniform"/>
                </ToggleButton>
                <ToggleButton Classes="seg"
                              IsChecked="{Binding ActiveTab.IsCompactView, Mode=OneWay}"
                              IsEnabled="{Binding ActiveTab.CanUseCompact}"
                              Command="{Binding ActiveTab.ShowAsCompactCommand}"
                              AutomationProperties.Name="small grid" ToolTip.Tip="small grid">
                  <!-- Two short columns: the shape of the layout itself. -->
                  <Path Data="M0,0 H5 V2 H0 Z M0,4 H5 V6 H0 Z M0,8 H5 V10 H0 Z M7,0 H12 V2 H7 Z M7,4 H12 V6 H7 Z M7,8 H12 V10 H7 Z"
                        Width="12" Height="12" Stretch="Uniform"/>
                </ToggleButton>
                <ToggleButton Classes="seg"
                              IsChecked="{Binding ActiveTab.IsGridView, Mode=OneWay}"
                              Command="{Binding ActiveTab.ShowAsGridCommand}"
                              AutomationProperties.Name="large grid" ToolTip.Tip="large grid">
                  <Path Data="M0,0 H5 V5 H0 Z M7,0 H12 V5 H7 Z M0,7 H5 V12 H0 Z M7,7 H12 V12 H7 Z"
                        Width="12" Height="12" Stretch="Uniform"/>
                </ToggleButton>
              </StackPanel>
            </Border>

            <!-- The details panel is a different choice, so it sits outside the
                 chip rather than behind a rule.

                 **Gated on ShowsWindowControls, and that was asked for
                 directly**: "only show the settings, split view, and detail
                 panel buttons on the right most window when in split mode. They
                 are not needed on the left split at all."

                 An audit later flagged the left half as having a panel with no
                 control to open it and it was ungated to fix that — which was
                 the audit reading the tooltip and not the request. F11 still
                 toggles whichever side is active, so the left half is not cut
                 off from the feature; it just does not carry a second copy of
                 the button. Reverted 14 August 2026. -->
            <ToggleButton Classes="seg"
                          IsVisible="{Binding ShowsWindowControls}"
                          IsChecked="{Binding IsInfoVisible}" IsEnabled="{Binding IsInfoToggleEnabled}"
                          AutomationProperties.Name="details panel for this side  (f11)"
                          ToolTip.Tip="details panel for this side  (f11)">
              <!-- Inset by half the stroke. Drawn on the 0..12 edges the outline
                   is clipped to half its width on all four sides, which is why
                   the design's own geometry starts at 0.7. -->
              <Path Classes="stroke" Data="M0.7,0.7 H11.3 V11.3 H0.7 Z M8,0.7 V11.3"
                    StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/>
            </ToggleButton>

            <!-- Split is window-level state inside a per-group template, hence
                 the $parent[Window] hop. It moved here from the sidebar header:
                 it is a view decision and belongs with the other view decisions,
                 not above a list of places it has nothing to do with. -->
            <ToggleButton Classes="seg"
                          IsVisible="{Binding ShowsWindowControls}"
                          IsChecked="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSplit, Mode=OneWay}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ToggleSplitCommand}"
                          AutomationProperties.Name="split view  (f3)" ToolTip.Tip="split view  (f3)">
              <!-- A 24-unit box at 13px with a 1.8 stroke, where the panel
                   toggle is a 12-unit box at 12px with 1.4. The design draws
                   these two at different weights on purpose: the split is the
                   heavier mark because it divides the window, not a pane. -->
              <Path Classes="stroke" Data="M2 2 H22 V22 H2 Z M12 2 V22"
                    StrokeThickness="0.98" Width="13" Height="13" Stretch="Uniform"/>
            </ToggleButton>

            <!-- Overflow last, where an overflow menu belongs. Declared in
                 VISUAL order along with everything above it — these used to be
                 four DockPanel.Dock="Right" children, where the first declared
                 sat furthest right and the source read backwards from the
                 screen. -->
            <!-- Ungated for the same reason as the panel toggle: everything
                 behind it — hidden files, text size, icon size — is per pane,
                 and on the left half of a split there was no way to reach any
                 of it. Clicking here makes this side active first (the window's
                 tunnelling press handler), so the shell-level commands inside
                 act on the pane that was clicked. -->
            <Button Content="&#x2261;"
                    FontSize="{DynamicResource FontSizeLarge}" Padding="8,2"
                    Foreground="{DynamicResource ViewDimText}"
                    Background="Transparent" BorderThickness="0"
                    IsVisible="{Binding ShowsWindowControls}"
                    AutomationProperties.Name="view options" ToolTip.Tip="view options">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="230" Spacing="10" Margin="4">

                  <!-- The Layout radio group and the "Details panel" checkbox
                       were here. The segmented control and the panel toggle in
                       the bar above are the same choices, one click away and
                       always visible, so keeping them here as well meant two
                       controls for one decision that could disagree on which
                       looked authoritative. -->

                  <!-- A view setting, so it belongs with the view settings
                       rather than occupying every path bar permanently. -->
                  <CheckBox Content="Show hidden files  (ctrl+h)"
                            FontSize="{DynamicResource FontSizeSmall}"
                            IsChecked="{Binding ActiveTab.ShowHidden}"/>

                  <!-- **The sidebar could only be toggled with Ctrl+B.** There
                       was no entry anywhere for it, so hiding it was something
                       you had to already know how to do — and getting it back
                       was the same problem with the sidebar gone. -->
<!-- F1 was the only way to the shortcut sheet, which is a
                       circular arrangement: the list of keys could only be
                       reached by knowing one of them. -->
                  <Button Content="Keyboard shortcuts…" Padding="0" MinHeight="0"
                          Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Left"
                          FontSize="{DynamicResource FontSizeSmall}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowShortcutsCommand}"/>

                                    <CheckBox Content="Sidebar  (ctrl+b or f9)"
                            FontSize="{DynamicResource FontSizeSmall}"
                            IsChecked="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.IsPanelVisible, Mode=OneWay}"
                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.CycleRailCommand}"/>

                  <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

                  <!-- One grid for both rows, so the labels and the steppers
                       line up instead of each row sizing itself. The value is
                       the real size, not the multiplier behind it — a number
                       you can type is only useful if it means something. -->
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">

                    <!-- **Which pane these act on.**
                         This flyout opens from the rightmost pane only, and
                         opening it makes that side active — so "this pane"
                         could only ever mean the right one, and the left half
                         of a split had no way to be sized at all except with
                         the wheel.

                         Hidden when there is one pane: with nothing to choose
                         between, a chooser is a question with one answer. -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Applies to"
                               VerticalAlignment="Center" Margin="0,0,12,6"
                               IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSplit}"
                               FontSize="{DynamicResource FontSizeSmall}"/>

                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                              Margin="0,0,0,6" MinHeight="26" Padding="8,0"
                              FontSize="{DynamicResource FontSizeSmall}"
                              IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSplit}"
                              AutomationProperties.Name="which pane the size controls change"
                              SelectedIndex="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ScaleTargetIndex}">
                      <ComboBoxItem Content="Left pane"/>
                      <ComboBoxItem Content="Right pane"/>
                      <ComboBoxItem Content="Both panes"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Text size"
                               VerticalAlignment="Center" Margin="0,0,12,6"
                               FontSize="{DynamicResource FontSizeSmall}"/>

                    <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                            CornerRadius="5" BorderThickness="1" Margin="0,0,0,6"
                            BorderBrush="{DynamicResource SeparatorColour}"
                            Background="{DynamicResource ViewBackground}">
                      <StackPanel Orientation="Horizontal">
                        <Button Content="&#x2212;" Width="30" Height="26" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                FontSize="{DynamicResource FontSizeBase}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="smaller text in this pane" ToolTip.Tip="smaller text in this pane"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).FontSmallerCommand}"/>
                        <!-- LostFocus, not per keystroke: committing mid-type
                             would apply "1" on the way to "14". -->
                        <TextBox local:FocusBehavior.CommitOnEnter="True"
                                 Text="{Binding $parent[Window].((vm:ShellViewModel)DataContext).TargetFontPoints, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Width="48" Height="26" Padding="0" MinHeight="0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 AutomationProperties.Name="text size in this pane"
                                 TextAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="+" Width="30" Height="26" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                FontSize="{DynamicResource FontSizeBase}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="larger text in this pane" ToolTip.Tip="larger text in this pane"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).FontLargerCommand}"/>
                      </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Icon size"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               FontSize="{DynamicResource FontSizeSmall}"/>

                    <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"
                            CornerRadius="5" BorderThickness="1"
                            BorderBrush="{DynamicResource SeparatorColour}"
                            Background="{DynamicResource ViewBackground}">
                      <StackPanel Orientation="Horizontal">
                        <Button Content="&#x2212;" Width="30" Height="26" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                FontSize="{DynamicResource FontSizeBase}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="smaller icons in this pane" ToolTip.Tip="smaller icons in this pane"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IconsSmallerCommand}"/>
                        <TextBox local:FocusBehavior.CommitOnEnter="True"
                                 Text="{Binding $parent[Window].((vm:ShellViewModel)DataContext).TargetIconPixels, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Width="48" Height="26" Padding="0" MinHeight="0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 AutomationProperties.Name="icon size in this pane"
                                 TextAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="+" Width="30" Height="26" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                FontSize="{DynamicResource FontSizeBase}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="larger icons in this pane" ToolTip.Tip="larger icons in this pane"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IconsLargerCommand}"/>
                      </StackPanel>
                    </Border>

                  </Grid>

                  <TextBlock Text="ctrl+wheel to scale, ctrl+wheel click to reset · add shift for icons only"
                             FontSize="{DynamicResource FontSizeTiny}"
                             Foreground="{DynamicResource ViewDimText}"
                             TextWrapping="Wrap" Margin="0,2,0,4"/>
                  <Button Content="Reset sizes" HorizontalAlignment="Stretch"
                          FontSize="{DynamicResource FontSizeSmall}"
                          ToolTip.Tip="Resets whichever panes are chosen above. Ctrl+0 resets the one you are working in."
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ResetTargetedScaleCommand}"/>

                  <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

                  <!-- This flyout is per-pane view options; settings are
                       application-wide. Separated by a rule rather than mixed
                       in, because the two undo differently — one is a view you
                       can change back, the other is a preference that persists. -->
                  <Button Content="Settings…" HorizontalAlignment="Stretch"
                          FontSize="{DynamicResource FontSizeSmall}"
                          AutomationProperties.Name="application settings  (ctrl+shift+,)" ToolTip.Tip="application settings  (ctrl+shift+,)"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenSettingsCommand}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            </Button>

          </StackPanel>

          <!-- The obvious way to reach an overflowed tab. The wheel scrolls the
               strip and the thin line shows where you are, but neither LOOKS
               clickable — a wheel is invisible until discovered. These exist
               only while there is somewhere to go: hidden when the tabs fit,
               dimmed at their own end of travel, so their presence itself says
               "there are more tabs than you can see". RepeatButtons, so holding
               one sweeps. Declared after the view buttons, so the right chevron
               docks against the strip rather than the window edge; not
               focusable, because Ctrl+Tab is the keyboard's way through tabs
               and these are pointer furniture. -->
          <RepeatButton DockPanel.Dock="Left" Classes="tab-nudge tab-nudge-left"
                        Content="&#x2039;" IsVisible="False"
                        Click="OnScrollTabsLeft"
                        AutomationProperties.Name="scroll tabs left" ToolTip.Tip="scroll tabs left"/>
          <RepeatButton DockPanel.Dock="Right" Classes="tab-nudge tab-nudge-right"
                        Content="&#x203A;" IsVisible="False"
                        Click="OnScrollTabsRight"
                        AutomationProperties.Name="scroll tabs right" ToolTip.Tip="scroll tabs right"/>

          <!-- Scrolled, and that is the fix rather than a nicety.
               A horizontal StackPanel measures its children with INFINITE width
               and does not clip, so the strip grew past the space the DockPanel
               gave it and painted straight over the layout buttons and the
               details-panel toggle docked to its right. A ScrollViewer is
               constrained by its parent and clips, so the tabs stop at the
               toolbar instead of climbing over it.
               The separator and + travel INSIDE it, so they stay adjacent to the
               last tab rather than jumping to the far edge when few tabs are
               open. Ctrl+T reaches the same command when they scroll out. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        ClipToBounds="True"
                        ScrollChanged="OnTabStripScrollChanged">
            <!-- The theme's own scrollbar is built for a document, and over a
                 row of tabs it reads as machinery: a bright thumb the height of
                 a button, with a stepper arrow at each end, painted across the
                 tab labels the moment the pointer nears it.

                 Pared back to the one part that says anything — a thin muted
                 line showing how far along the strip you are — pinned to the
                 bottom edge rather than floating over the text. The steppers go
                 because a tab strip is dragged and wheeled, not stepped a
                 pixel at a time, and each arrow costs more width than it earns.

                 Scoped to this ScrollViewer, so listings and panels keep the
                 ordinary scrollbar people expect on a scrolling surface. -->
            <ScrollViewer.Styles>
              <Style Selector="ScrollBar:horizontal">
                <Setter Property="Height" Value="3"/>
                <Setter Property="MinHeight" Value="3"/>
                <Setter Property="Margin" Value="0,0,0,1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Opacity" Value="0.55"/>
              </Style>

              <!-- Slightly present while actually being used, and still nothing
                   like a control. -->
              <Style Selector="ScrollBar:horizontal:pointerover">
                <Setter Property="Height" Value="5"/>
                <Setter Property="MinHeight" Value="5"/>
                <Setter Property="Opacity" Value="0.9"/>
              </Style>

              <!-- Both steppers and both page-buttons: none of them belong on a
                   strip this size. -->
              <Style Selector="ScrollBar:horizontal /template/ RepeatButton">
                <Setter Property="IsVisible" Value="False"/>
                <Setter Property="Width" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
              </Style>

              <Style Selector="ScrollBar:horizontal /template/ Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
              </Style>

              <Style Selector="ScrollBar:horizontal /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource ViewDimText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="MinHeight" Value="3"/>
              </Style>

              <Style Selector="ScrollBar:horizontal /template/ Thumb:pointerover">
                <Setter Property="Background" Value="{DynamicResource ViewDimText}"/>
              </Style>
            </ScrollViewer.Styles>
          <StackPanel Orientation="Horizontal">
          <!-- Tabs take drops. A cross-tab move otherwise needs the split
               view, which means opening the other side just to move one file;
               and resting on a tab for a moment switches to it, so a drag can
               reach a folder that is not on screen. Both references do each. -->
          <TabStrip ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}"
                    DragDrop.AllowDrop="True"
                    SelectionChanged="OnTabStripSelectionChanged">
            <TabStrip.Styles>
              <!-- The active tab takes the *content* colour, so it reads as
                   continuous with the listing beneath it. Inactive tabs stay on
                   the chrome. That contrast is the tab metaphor; without it a
                   tab strip is just a row of labels on one flat band. -->
              <Style Selector="TabStripItem">
                <Setter Property="Foreground" Value="{DynamicResource ViewDimText}"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
              </Style>
              <!-- Padding belongs on the ContentPresenter, not the item: the
                   presenter is what draws the tab surface, so it is what has to
                   grow. Padding on the item only helps if the control theme
                   forwards it, and the visible box stays tight when it does not. -->
              <Style Selector="TabStripItem /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="4,4,0,0"/>
                <Setter Property="Padding" Value="16,9"/>
                <!-- Zero in the BASE style, and zero in every state. The
                     selected tab used to draw a bevel here; with the chrome flat
                     the only thing carrying the tab metaphor is ViewBackground
                     against ChromeBrush, so a border would be a second, weaker
                     answer to a question already answered.
                     The thickness stays declared rather than dropped because the
                     standing rule is that a per-state style may change colour and
                     the visibility of an overlaid element and nothing that
                     affects layout — stating it at 0 here is what keeps that
                     true if a state ever wants a brush again. -->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
              </Style>
              <Style Selector="TabStripItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
              </Style>
              <Style Selector="TabStripItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource ViewText}"/>
              </Style>
              <Style Selector="TabStripItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ViewBackground}"/>
              </Style>
            </TabStrip.Styles>
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="vm:PaneViewModel">
                <!-- **A DockPanel, not a horizontal StackPanel.** A StackPanel
                     measures its children with infinite width, so the title's
                     TextTrimming below could never fire in one — the rule this
                     file already keeps for the sidebar's network rows. Docking
                     the close button first leaves the title a real width to
                     trim into. -->
                <DockPanel LastChildFill="True">
                  <!-- The only close affordance in the strip, so it does not get
                       to be the smallest and faintest thing in the window. It
                       pinned at font size 9, half opacity and 2px padding while
                       the title beside it scaled — so raising the font scale made this
                       WORSE, the title growing around a fixed target. Size now
                       tracks the scale, and the dim comes from the colour scheme
                       (ViewDimText) rather than a literal opacity, which put the
                       effective contrast outside anything Plasma could set. -->
                  <Button DockPanel.Dock="Right" Content="&#x2715;"
                          FontSize="{DynamicResource FontSizeSmall}"
                          Foreground="{DynamicResource ViewDimText}"
                          Background="Transparent" BorderThickness="0"
                          Padding="6,3" Margin="11,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="close tab  (ctrl+w)" ToolTip.Tip="close tab  (ctrl+w)"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}"/>

                  <!-- **Capped and trimmed.** One folder called
                       "Screenshots from the trip to Norway 2024" made a tab
                       hundreds of pixels wide and pushed every other tab off
                       the strip. The full path is in the tooltip, which is
                       where a trimmed label belongs. -->
                  <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBase}"
                             VerticalAlignment="Center"
                             MaxWidth="220" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding CurrentPath}"/>

                  <!-- **A tab had no menu at all.** With a dozen open, closing
                       them one at a time was the only route; both references
                       offer these three. The commands are on the shell, so the
                       bindings reach out through the Window the way the rest of
                       this file's shell-level rows do. -->
                  <DockPanel.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Duplicate"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).DuplicateTabCommand}"
                                CommandParameter="{Binding}"/>
                      <Separator/>
                      <MenuItem Header="Close" InputGesture="Ctrl+W"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                                CommandParameter="{Binding}"/>
                      <MenuItem Header="Close other tabs"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseOtherTabsCommand}"
                                CommandParameter="{Binding}"/>
                      <MenuItem Header="Close tabs to the right"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseTabsToTheRightCommand}"
                                CommandParameter="{Binding}"/>
                      <Separator/>
                      <MenuItem Header="Reopen closed tab" InputGesture="Ctrl+Shift+T"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ReopenClosedTabCommand}"/>
                    </ContextMenu>
                  </DockPanel.ContextMenu>
                </DockPanel>
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
          <!-- A rule, then the action. It is not another tab, so it gets
               neither the tab surface nor the tab text colour. -->
          <Border Width="1" Margin="8,8,0,10"
                  Background="{DynamicResource SeparatorColour}"/>
          <Button Content="+" FontSize="{DynamicResource FontSizeLarge}"
                  Foreground="{DynamicResource ViewDimText}"
                  Background="Transparent" BorderThickness="0"
                  Padding="10,2" Margin="6,0,0,4" VerticalAlignment="Center"
                  Command="{Binding NewTabHereCommand}"
                  AutomationProperties.Name="new tab in this pane  (ctrl+t)" ToolTip.Tip="new tab in this pane  (ctrl+t)"/>
          </StackPanel>
          </ScrollViewer>
         </DockPanel>
        </Border>

        <!-- One path bar per side, Dolphin-style: clickable ancestors, with
             an editable box behind them for typing or pasting a path — and now
             the search field and the filter, which is why it is a toolbar
             rather than a path strip.

             Height is fixed rather than derived from Padding so the row does
             not grow by a pixel when the search field's border is present. -->
        <Border DockPanel.Dock="Top" Height="40" Padding="10,0"
                Background="{DynamicResource ChromeBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SeparatorColour}">
          <DockPanel>
            <!-- Stroked chevrons rather than arrow glyphs: they take the icon
                 scale and the icon weight, so they stop reading as text set in
                 the middle of a toolbar. Disabled state stays the control's own
                 opacity. -->
            <Button DockPanel.Dock="Left" Width="30"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="back  (alt+left)" ToolTip.Tip="back  (alt+left)"
                    Command="{Binding ActiveTab.GoBackCommand}"
                    IsEnabled="{Binding ActiveTab.CanGoBack}">
              <Path Data="M15 5 L8 12 L15 19" Stroke="{DynamicResource ViewText}"
                    StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform"/>
            </Button>
            <Button DockPanel.Dock="Left" Width="30"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="forward  (alt+right)" ToolTip.Tip="forward  (alt+right)"
                    Command="{Binding ActiveTab.GoForwardCommand}"
                    IsEnabled="{Binding ActiveTab.CanGoForward}">
              <Path Data="M9 5 L16 12 L9 19" Stroke="{DynamicResource ViewText}"
                    StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform"/>
            </Button>
            <Button DockPanel.Dock="Left" Width="30" Margin="0,0,6,0"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="up one folder  (alt+up)" ToolTip.Tip="up one folder  (alt+up)"
                    Command="{Binding ActiveTab.GoUpCommand}"
                    IsEnabled="{Binding ActiveTab.CanGoUp}">
              <Path Data="M5 15 L12 8 L19 15" Stroke="{DynamicResource ViewText}"
                    StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform"/>
            </Button>

            <!-- Right cluster: search, then filter. Declared before the crumbs
                 so the crumbs, as the last child, still take the remaining
                 width. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">

              <!-- ONE search per window, so it renders on the active side only.
                   The split's two path bars would otherwise show the same query
                   twice and leave "which box am I typing in" ambiguous. -->
              <Panel IsVisible="{Binding IsActiveGroup}">

                <!-- Collapsed: the field is a 230px block that never yielded,
                     and on the active side of a split it plus the filter button
                     took the whole path bar — the crumbs were reduced to "C:".
                     A toolbar's permanent residents should be the ones you use
                     constantly, and search is not one of them.

                     Same magnifier as the field's own, so opening it reads as
                     the icon growing rather than one control replacing another. -->
                <Button IsVisible="{Binding !$parent[Window].((vm:ShellViewModel)DataContext).Sidebar.IsSearchOpen}"
                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.FocusSearchCommand}"
                        Width="30" Height="26" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="search files  (ctrl+f)"
                        ToolTip.Tip="search files  (ctrl+f)">
                  <Path Width="13" Height="13" Stretch="Uniform"
                        Data="M10.5 4 a6.5 6.5 0 1 0 0 13 a6.5 6.5 0 1 0 0 -13 M15.5 15.5 L20 20"
                        Stroke="{DynamicResource ViewDimText}" StrokeThickness="1.03"
                        StrokeLineCap="Round" Fill="Transparent"/>
                </Button>

                <Border x:Name="SearchBox" Width="230" Height="26" CornerRadius="4"
                        IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.IsSearchOpen}"
                        Background="{DynamicResource ViewBackground}"
                        BorderThickness="1" BorderBrush="{DynamicResource SeparatorColour}">
                  <DockPanel>
                    <Path DockPanel.Dock="Left" Margin="8,0" Width="13" Height="13" Stretch="Uniform"
                          Data="M10.5 4 a6.5 6.5 0 1 0 0 13 a6.5 6.5 0 1 0 0 -13 M15.5 15.5 L20 20"
                          Stroke="{DynamicResource ViewDimText}" StrokeThickness="1.03"
                          StrokeLineCap="Round" Fill="Transparent"/>
                    <!-- Dimmer than the placeholder beside it. The design sets
                         the hint below the placeholder rather than level with
                         it, so the field reads as one thing with a note on it
                         rather than two labels competing. -->
                    <TextBlock DockPanel.Dock="Right" Text="ctrl+f" Margin="6,0,8,0"
                               VerticalAlignment="Center" Opacity="0.7"
                               FontSize="{DynamicResource FontSizeTiny}"
                               Foreground="{DynamicResource ViewDimText}"
                               IsVisible="{Binding !$parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.HasQuery}"/>
                    <TextBox Text="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.Query}"
                             local:FocusBehavior.FocusWhen="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.IsSearching}"
                             local:FocusBehavior.LostFocusCommand="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.CloseSearchIfEmptyCommand}"
                             PlaceholderText="search files"
                             Classes="flat"
                             Background="Transparent" BorderThickness="0"
                             MinHeight="0" Padding="0,3" VerticalContentAlignment="Center"
                             FontSize="{DynamicResource FontSizeSmall}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Escape"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.DismissSearchCommand}"/>
                        <!-- **Enter did nothing here**, so type-then-Enter —
                             the reflex in both Explorer and Dolphin — dead-ended
                             and a result could only be reached with the mouse.
                             Down is the other half: it puts the keyboard in the
                             results, which are a real list now rather than a
                             column of buttons. -->
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.OpenFirstCommand}"/>
                        <KeyBinding Gesture="Down"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.FocusResultsListCommand}"/>
                      </TextBox.KeyBindings>
                    </TextBox>
                    <!-- Padding="0" collapsed the text presenter to the font's
                         line box, and the selection highlight is drawn to the
                         presenter while the glyphs sit on their own baseline —
                         so ascenders and descenders spilled a pixel past the
                         highlight. MinHeight stays 0, or Fluent's default 32
                         would burst the 26px field. -->
                    <!-- Nothing below this line: DockPanel gives its last child
                         the remaining space, and that has to be the TextBox. -->
                  </DockPanel>
                </Border>

                <!-- Results in a popup under the field, not in the sidebar. They
                     used to replace the places list, so searching took away the
                     thing you navigate with. -->
                <Popup PlacementTarget="{Binding #SearchBox}"
                       Placement="BottomEdgeAlignedRight" VerticalOffset="6"
                       IsLightDismissEnabled="True"
                       IsOpen="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.HasQuery, Mode=OneWay}">
                  <Border Width="520" MaxHeight="420" CornerRadius="4" Padding="0,6"
                          Background="{DynamicResource PanelBackground}"
                          BorderThickness="1" BorderBrush="{DynamicResource SeparatorColour}">
                    <DockPanel>
                      <!-- **The scope toggle existed and no control could set
                           it.** ScopeToCurrentFolder is an observable property
                           with a live handler that restarts the search, and
                           both platforms already implement the unscoped case —
                           so searching the whole machine was built, tested by
                           neither, and unreachable. -->
                      <CheckBox DockPanel.Dock="Top" Margin="12,0,12,4"
                                Content="This folder only"
                                FontSize="{DynamicResource FontSizeTiny}"
                                IsChecked="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.ScopeToCurrentFolder}"/>
                      <TextBlock DockPanel.Dock="Top"
                                 Text="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.Status}"
                                 Margin="12,2,12,6" TextWrapping="Wrap"
                                 FontSize="{DynamicResource FontSizeTiny}"
                                 Foreground="{DynamicResource ViewDimText}"/>
                      <ScrollViewer>
                        <!-- **A ListBox, not a column of Buttons.** Buttons
                             carry no selection, so there was nothing for an
                             arrow key to move and nothing for Enter to open —
                             the results were mouse-only. A real list brings
                             arrow navigation, a visible focus and Enter for
                             free; opening on selection is what the popup does
                             anyway, since choosing a result is the only thing
                             you can do with one. -->
                        <ListBox x:Name="SearchResults"
                                 local:FocusBehavior.FocusWhen="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.FocusResults}"
                                 ItemsSource="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.Results}"
                                 SelectionMode="Single" Background="Transparent" Padding="0"
                                 BorderThickness="0">
                          <ListBox.KeyBindings>
                            <KeyBinding Gesture="Enter"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.Search.OpenCommand}"
                                        CommandParameter="{Binding #SearchResults.SelectedItem}"/>
                            <KeyBinding Gesture="Escape"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.DismissSearchCommand}"/>
                          </ListBox.KeyBindings>
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="fs:FileEntry">
                              <StackPanel Margin="12,7">
                                <TextBlock Text="{Binding Converter={x:Static vm:FileConverters.DisplayName}}" FontSize="{DynamicResource FontSizeBase}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FullPath}" FontSize="{DynamicResource FontSizeTiny}"
                                           Foreground="{DynamicResource ViewDimText}"
                                           TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                          <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                              <Setter Property="Padding" Value="0"/>
                            </Style>
                          </ListBox.Styles>
                        </ListBox>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </Popup>
              </Panel>

              <!-- Filter, inline. It used to be a band of its own that appeared
                   on Ctrl+I and shoved the whole listing down; here the chip
                   becomes the field and nothing moves. -->
              <ToggleButton Padding="8,3" MinWidth="0" CornerRadius="4"
                            Background="Transparent" BorderThickness="0"
                            IsChecked="{Binding ActiveTab.IsFilterVisible, Mode=OneWay}"
                            Command="{Binding ActiveTab.ToggleFilterCommand}"
                            IsVisible="{Binding !ActiveTab.IsFilterVisible}"
                            AutomationProperties.Name="filter the listing  (ctrl+i)"
                            ToolTip.Tip="filter the listing  (ctrl+i)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Data="M3 6 H21 M6.5 12 H17.5 M10 18 H14"
                        Stroke="{DynamicResource ViewDimText}" StrokeThickness="1.03"
                        StrokeLineCap="Round" Fill="Transparent"
                        Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Text="Filter" FontSize="{DynamicResource FontSizeSmall}"
                             Foreground="{DynamicResource ViewDimText}" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>

              <TextBox Width="200" Height="26" MinHeight="0" Padding="8,0" CornerRadius="4"
                       VerticalContentAlignment="Center"
                       IsVisible="{Binding ActiveTab.IsFilterVisible}"
                       Text="{Binding ActiveTab.FilterText}"
                       local:FocusBehavior.FocusOnVisible="True"
                       PlaceholderText="filter — esc to clear"
                       FontFamily="monospace" FontSize="{DynamicResource FontSizeSmall}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Escape" Command="{Binding ActiveTab.ClearFilterCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>

            </StackPanel>

            <Panel>
              <!-- The double-click target sits BEHIND the crumbs and fills the
                   bar, rather than being a strip beside them.
                   
                   It carries no single-click handler on purpose. It used to,
                   and that is what made double-click unreliable: the first
                   click opened the editor, which replaced the crumbs with the
                   text box, so the second click landed somewhere else and the
                   gesture never completed. Two handlers on one target, where
                   the first destroys what the second needs.
                   
                   Crumbs sit on top and keep their single click to navigate. -->
              <Border Background="Transparent"
                      IsVisible="{Binding !ActiveTab.IsPathEditing}"
                      local:DoubleClick.Command="{Binding ActiveTab.BeginEditPathCommand}"
                      ToolTip.Tip="double-click to edit the path  (ctrl+l)"/>

              <DockPanel IsVisible="{Binding !ActiveTab.IsPathEditing}">
                <!-- The tooltip carries the path in full, because the bar
                     shows folder NAMES and elides the middle when it must —
                     neither of which can be copied or read as a whole. A slow
                     reveal on purpose: the pointer crosses this strip on the
                     way to the back button and the search box, and a tooltip
                     that fires in transit is noise rather than help. -->
                <!-- The DISPLAY path, not CurrentPath: a virtual listing's path
                     is an internal scheme, and the tooltip was showing
                     "vaktari:computer" to anyone who hovered the bar. -->
                <!-- Crumbs take drops: dragging a file onto an ancestor is the
                     shortest way to move it up two levels, and it is what both
                     references do. The destination comes from the segment under
                     the pointer, so the crumb has to be able to be a target at
                     all — without AllowDrop the drag never reaches it and the
                     pane underneath answers with its own folder, which is where
                     the file already is. -->
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding ActiveTab.Breadcrumbs}"
                              DragDrop.AllowDrop="True"
                              ToolTip.Tip="{Binding ActiveTab.DisplayPath}"
                              ToolTip.ShowDelay="1200">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <local:BreadcrumbPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PathSegment">
                      <StackPanel Orientation="Horizontal">
                        <!-- The name goes in a TextBlock, NOT in Content.
                             A Button renders its content through AccessText,
                             which treats "_" as an access-key marker: it eats
                             the underscore and underlines the next letter, so
                             "git_projects" rendered as "gitprojects". Folder
                             names are data, not labels, and must never be
                             parsed for mnemonics. -->
                        <Button Command="{Binding Open}"
                                AutomationProperties.Name="{Binding Name}"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,2" CornerRadius="3">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="{Binding IsLast, Converter={x:Static vm:FileConverters.CrumbWeight}}"
                                     Foreground="{Binding IsLast, Converter={x:Static vm:FileConverters.CrumbBrush}}"
                                     FontSize="{DynamicResource FontSizeBase}"/>
                        </Button>
                        <!-- No trailing separator after the current folder, and
                             none after a root, which carries its own. -->
                        <TextBlock Text="{x:Static vm:PathSegment.Separator}"
                                   VerticalAlignment="Center" Margin="1,0"
                                   IsVisible="{Binding ShowSeparator}"
                                   Foreground="{DynamicResource ViewDimText}"
                                   FontSize="{DynamicResource FontSizeSmall}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fills the rest so the crumbs stay left-aligned, and passes
                     clicks through to the target behind it. -->
                <Panel IsHitTestVisible="False"/>
              </DockPanel>

              <TextBox Text="{Binding ActiveTab.PathText}"
                       IsVisible="{Binding ActiveTab.IsPathEditing}"
                       ToolTip.Tip="tab completes · enter goes · esc or click away cancels&#10;%ProgramFiles%, %SystemDrive% and ~ are understood"
                       local:FocusBehavior.LostFocusCommand="{Binding ActiveTab.RevertPathTextCommand}"
                       local:FocusBehavior.FocusOnVisible="True"
                       FontFamily="monospace" FontSize="{DynamicResource FontSizeSmall}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter"
                              Command="{Binding ActiveTab.NavigateToPathTextCommand}"/>
                  <KeyBinding Gesture="Escape"
                              Command="{Binding ActiveTab.RevertPathTextCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
            </Panel>
          </DockPanel>
        </Border>

        <!-- The filter's own band was here. It appeared on Ctrl+I and pushed
             the listing down by its full height, so turning on a filter moved
             every row you were looking at. It is a field in the path bar now. -->

        <!-- The only cue for which half takes the next keystroke, so it has to
             be visible but quiet. -->


        <ItemsControl ItemsSource="{Binding Tabs}" Background="{DynamicResource ViewBackground}">

          <ItemsControl.ContextMenu>
            <!--
                 One menu for a file row AND for the empty space below it, which
                 is why so much of it is gated on HasSelection: everything that
                 acts on a selection was listed, enabled, on an empty-space
                 right-click, and did nothing at all when picked.

                 Hiding rather than disabling, to match the Show*InMenu
                 preferences already here. Safe to gate this way because a
                 right-click selects the row under the pointer first — the
                 entries are there whenever the click was on something.
            -->
            <ContextMenu x:DataType="vm:PaneGroupViewModel" Closed="OnListingMenuClosed"
                         Opening="OnListingMenuOpening">
              <!-- **Every row here that has a key binding prints it.** Ten did
                   and none said so, which left the keyboard route discoverable
                   only by reading the source — and an entry nobody knows is
                   reachable by key is the first one argued as redundant.

                   InputGesture rather than the "  (ctrl+x)" suffix this file
                   puts on tooltips and flyout labels: it is display-only, so it
                   cannot collide with the Window.KeyBindings below or with the
                   code-behind switch that actually owns Enter, Alt+Enter and
                   Delete. MenuItem.HotKey is the property that WOULD register a
                   second handler — deliberately not used. The theme also
                   right-aligns the gesture in its own column, which a suffix
                   baked into the header cannot do.

                   Only rows with a real binding get one: a printed gesture that
                   does nothing is worse than none, which is why "Open with",
                   "Copy to", "Move to", "New", "More", "Scripts" and the share
                   entry — parents with no command of their own — stay bare. -->
              <!-- CanActOnSelection, not HasSelection: a bin row names where a
                   file used to be, and opening that path opens whatever is
                   there now, if anything. -->
              <MenuItem Header="Open"
                                      Command="{Binding ActiveTab.OpenSelectedCommand}"
                                      InputGesture="Enter"
                                      IsVisible="{Binding ActiveTab.CanActOnSelection}"/>
              <!-- **Named, and the style anchored to that name, because a bare
                   `MenuItem > MenuItem` selector matches the MenuItem it is
                   DECLARED ON.** A style applies to its host as well as to the
                   host's descendants, so as soon as one of these moved inside
                   another MenuItem — which consolidating the menu did to New
                   file, New from template and Scripts — the host matched its
                   own rule and took a Command expecting one of its own items,
                   with a CommandParameter that is the pane group. Avalonia
                   calls CanExecute on every child when a submenu opens, so
                   clicking "New" ended the process on an ArgumentException.

                   Anchoring on the name excludes the host, whose parent is a
                   different element, and still reaches the generated item
                   containers. Done to all six rather than the three that were
                   nested: the others are safe only because of where they
                   happen to sit today, and where they sit is what changed. -->
              <MenuItem x:Name="OpenWithMenu" Header="Open with"
                                      IsVisible="{Binding ActiveTab.HasOpenWithOptions}"
                                      ItemsSource="{Binding ActiveTab.OpenWithOptions}">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="fs:LaunchOption">
                                  <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem#OpenWithMenu > MenuItem" x:DataType="fs:LaunchOption">
                                  <Setter Property="Command"
                                          Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.OpenWithAppCommand}"/>
                                  <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
              <!-- **The critical verbs live at the top, unburied.** Run as
                   administrator shows for any executable on a PLAIN
                   right-click — Explorer never hid it behind Shift, and copying
                   that gate here meant an ordinary click on an .exe offered no
                   elevation anywhere visible. Open in new tab earns the same
                   promotion: it was living in "More" while being one of the
                   most-used folder actions a file manager has. -->
              <MenuItem Header="Run as administrator"
                                      Command="{Binding ActiveTab.RunAsAdministratorCommand}"
                                      IsVisible="{Binding ActiveTab.CanRunSelectionAsAdministrator}"/>
              <!-- **A verb of its own, and Open is left alone.** Explorer
                   mounts an .iso on double-click; doing the same here would
                   change what Open means for a file type, silently, for
                   everyone who had it opening in an archive tool. Mount says
                   what it does and is one click away.

                   The two entries are mutually exclusive — an image is either
                   attached or it is not — so this is one row that changes its
                   word, not two rows to choose between. -->
              <MenuItem Header="Mount"
                                      Command="{Binding ActiveTab.MountImageCommand}"
                                      IsVisible="{Binding ActiveTab.CanMountSelection}"/>
              <MenuItem Header="Unmount"
                                      Command="{Binding ActiveTab.UnmountImageCommand}"
                                      IsVisible="{Binding ActiveTab.CanUnmountSelection}"/>
              <MenuItem Header="Open in new tab"
                                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenInNewTabCommand}"
                                      CommandParameter="{Binding ActiveTab.SelectedEntry}"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowOpenInNewTabInMenu}"/>
              <!-- One home for both ways of sharing, instead of Proton entries
                   at the top level and copyparty three layers under "More".
                   Which rows show is decided in OnListingMenuOpening, because
                   the Proton half is per-item. -->
              <MenuItem x:Name="ShareMenu" Header="Share" IsVisible="False">
                <!-- Proton links. Hidden by default; OnListingMenuOpening shows
                     the pair that applies — share, or copy-and-stop — because
                     whether an item CAN be linked (inside the drive folder, CLI
                     present) and whether it already IS are per-item questions a
                     static binding cannot ask. -->
                <MenuItem x:Name="ProtonShareItem" Header="Share via Proton Drive"
                          IsVisible="False" Click="OnProtonShareClicked"/>
                <MenuItem x:Name="ProtonCopyLinkItem" Header="Copy Proton Drive link"
                          IsVisible="False" Click="OnProtonCopyLinkClicked"/>
                <MenuItem x:Name="ProtonUnshareItem" Header="Stop sharing via Proton Drive"
                          IsVisible="False" Click="OnProtonUnshareClicked"/>
                <!-- Takes the share row's place while the CLI downloads — the
                     share click fetches the tool itself when it is missing,
                     so this is the only install UI there is. -->
                <MenuItem x:Name="ProtonInstallingItem" Header="Setting up Proton Drive sharing…"
                          IsEnabled="False" IsVisible="False"/>
                <Separator x:Name="ShareMethodSeparator" IsVisible="False"/>
                <!-- **Flat, like the Proton rows above it: one row per thing
                     that can happen, never a second hover.** Wrapping these in
                     a "Share x over network" submenu made THREE levels for what
                     Explorer and Dolphin do in one. Each row carries its own
                     state gate, and the states cover each other — ready,
                     missing, installing — so the visible set is never empty
                     while the platform has a backend at all.

                     The read-only share is the unqualified row because it is
                     the safe default; the variant says exactly what it adds.
                     Both name the folder, so which one gets served is visible
                     before clicking rather than discovered afterwards. -->
                <MenuItem IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CanShare}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShareFolderCommand}">
                  <MenuItem.Header>
                    <TextBlock>
                      <Run Text="Share"/><Run Text=" "/><Run Text="{Binding ActiveTab.ShareTargetLabel}"/><Run Text=" over network"/>
                    </TextBlock>
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CanShare}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShareFolderWritableCommand}">
                  <MenuItem.Header>
                    <TextBlock>
                      <Run Text="Share"/><Run Text=" "/><Run Text="{Binding ActiveTab.ShareTargetLabel}"/><Run Text=" over network, allow uploads"/>
                    </TextBlock>
                  </MenuItem.Header>
                </MenuItem>
                <!-- No ellipsis, by the rule stated above and on the bin's
                     Empty button: it promises the entry asks first, and this
                     one starts the download the moment it is clicked. The
                     entry already names what it installs, so the label is the
                     question and the click is the answer. -->
                <MenuItem Header="Install copyparty to share folders"
                          IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CanInstallSharing}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).InstallSharingCommand}"/>
                <!-- Disabled and present, rather than absent: the download is
                     the one state where somebody is waiting on an answer, and
                     it is exactly the state that used to show nothing. -->
                <MenuItem Header="Installing copyparty…" IsEnabled="False"
                          IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsInstalling}"/>
              </MenuItem>
              <!-- Gated with the block ABOVE it, not the one below. Open and
                   Open with are the only entries up there and both need a
                   selection, so without this the menu opened with a rule as its
                   first item. Avalonia draws every separator it is given and
                   collapses none of them. -->
              <Separator IsVisible="{Binding ActiveTab.HasSelection}"/>
              <MenuItem Header="Cut"   Command="{Binding ActiveTab.CutSelectionToClipboardCommand}"
                                      InputGesture="Ctrl+X"
                                      IsVisible="{Binding ActiveTab.CanActOnSelection}"/>
              <MenuItem Header="Copy"  Command="{Binding ActiveTab.CopySelectionToClipboardCommand}"
                                      InputGesture="Ctrl+C"
                                      IsVisible="{Binding ActiveTab.HasSelection}"/>
              <!-- **Back at the top level, where they were before the menu was
                   consolidated.** Pushing these four behind "More" made the
                   menu tidy and made the things people reach for a hover
                   further away, which is the wrong trade for a menu opened
                   dozens of times an hour. The genuinely rare entries — scripts,
                   sharing, places — stayed there.

                   "Copy as path" rather than "Copy location": it is the same
                   action Windows offers under that name, on the same gesture,
                   and matching the vernacular costs nothing. -->
              <MenuItem Header="Copy as path"
                                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CopyLocationCommand}"
                                      InputGesture="Ctrl+Shift+C"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowCopyLocationInMenu}"/>
              <MenuItem Header="Paste" Command="{Binding ActiveTab.PasteCommand}"
                                      InputGesture="Ctrl+V"
                                      IsVisible="{Binding !ActiveTab.IsTrashListing}"/>
              <MenuItem x:Name="CopyToMenu" Header="Copy to"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowCopyToInMenu}"
                                      ItemsSource="{Binding $parent[Window].((vm:ShellViewModel)DataContext).TransferTargets}">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaceItemViewModel">
                                  <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem#CopyToMenu > MenuItem" x:DataType="vm:PlaceItemViewModel">
                                  <Setter Property="Command"
                                          Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CopySelectionToCommand}"/>
                                  <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
              <MenuItem x:Name="MoveToMenu" Header="Move to"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowMoveToInMenu}"
                                      ItemsSource="{Binding $parent[Window].((vm:ShellViewModel)DataContext).TransferTargets}">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaceItemViewModel">
                                  <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem#MoveToMenu > MenuItem" x:DataType="vm:PlaceItemViewModel">
                                  <Setter Property="Command"
                                          Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).MoveSelectionToCommand}"/>
                                  <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
              <!-- Rename and the bin are the whole of the block below, and both
                   need a selection outside the trash — so this rule goes with
                   them, or it stacks against the one before New. -->
              <Separator IsVisible="{Binding ActiveTab.CanActOnSelection}"/>
              <MenuItem Header="Duplicate"     Command="{Binding ActiveTab.DuplicateSelectedCommand}"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowDuplicateInMenu}"/>
              <MenuItem Header="Rename"        Command="{Binding ActiveTab.BeginRenameCommand}"
                                      InputGesture="F2"
                                      IsVisible="{Binding ActiveTab.CanActOnSelection}"/>
              <MenuItem Header="Rename in bulk…"
                                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).BatchRenameCommand}"
                                      InputGesture="Shift+F2"
                                      IsVisible="{Binding ActiveTab.CanActOnSelection}"/>
              <MenuItem Header="{Binding $parent[Window].((vm:ShellViewModel)DataContext).BinMoveLabel}"
                                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).TrashSelectionCommand}"
                                      InputGesture="Delete"
                                      IsVisible="{Binding ActiveTab.CanActOnSelection}"/>
              <Separator/>
              <!--
                   One "New" rather than three top-level entries that all create
                   something.
              -->
              <MenuItem Header="New"
                                      IsVisible="{Binding !ActiveTab.IsTrashListing}">
                <MenuItem Header="New folder"          Command="{Binding ActiveTab.NewFolderCommand}"
                                        InputGesture="Ctrl+Shift+N"/>
                <MenuItem x:Name="NewFileMenu" Header="New file" ItemsSource="{Binding ActiveTab.NewFileKinds}">
                                <MenuItem.ItemTemplate>
                                  <DataTemplate x:DataType="fs:NewFileKind">
                                    <TextBlock Text="{Binding Label}"/>
                                  </DataTemplate>
                                </MenuItem.ItemTemplate>
                                <MenuItem.Styles>
                                  <Style Selector="MenuItem#NewFileMenu > MenuItem" x:DataType="fs:NewFileKind">
                                    <Setter Property="Command"
                                            Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.NewFileCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                  </Style>
                                </MenuItem.Styles>
                              </MenuItem>
                <MenuItem x:Name="NewTemplateMenu" Header="New from template"
                                        ItemsSource="{Binding ActiveTab.Templates}"
                                        IsVisible="{Binding ActiveTab.HasTemplates}">
                                <MenuItem.ItemTemplate>
                                  <DataTemplate x:DataType="fs:FileTemplate">
                                    <TextBlock Text="{Binding Name}"/>
                                  </DataTemplate>
                                </MenuItem.ItemTemplate>
                                <MenuItem.Styles>
                                  <Style Selector="MenuItem#NewTemplateMenu > MenuItem" x:DataType="fs:FileTemplate">
                                    <Setter Property="Command"
                                            Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.NewFromTemplateCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                  </Style>
                                </MenuItem.Styles>
                              </MenuItem>
              </MenuItem>
              <!--
                   Sorting and grouping are one decision about how the listing reads,
                   and were two adjacent submenus making it look like two. The
                   settings checkbox governs the whole submenu for the same reason:
                   hiding one half and leaving the other stranded was never a state
                   anyone asked for.
              -->
              <!-- Refresh had F5 and nowhere to be found. Mostly covered by the
                   folder watcher, which is why it is here rather than higher —
                   but a listing that has gone stale is exactly when somebody
                   goes looking for it in a menu. -->
              <MenuItem Header="Refresh"
                                      Command="{Binding ActiveTab.RefreshCommand}"
                                      InputGesture="F5"/>
              <!-- **Selection had exactly one command and no menu home.**
                   Ctrl+A worked and was findable only by knowing it; there was
                   no way at all to clear a selection or invert one. Together
                   because they are one decision about what is chosen. -->
              <MenuItem Header="Select">
                <MenuItem Header="All" InputGesture="Ctrl+A" Click="OnSelectAllClicked"/>
                <MenuItem Header="None" Click="OnSelectNoneClicked"/>
                <MenuItem Header="Invert" InputGesture="Ctrl+Shift+A" Click="OnInvertSelectionClicked"/>
              </MenuItem>
              <MenuItem Header="Arrange"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowSortByInMenu}">
                <MenuItem Header="Sort by">
                                <MenuItem Header="Name" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsSortedByName, Mode=OneWay}"
                                          Command="{Binding ActiveTab.SortByNameCommand}"/>
                                <MenuItem Header="Size" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsSortedBySize, Mode=OneWay}"
                                          Command="{Binding ActiveTab.SortBySizeCommand}"/>
                                <MenuItem Header="Modified" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsSortedByModified, Mode=OneWay}"
                                          Command="{Binding ActiveTab.SortByModifiedCommand}"/>
                                <MenuItem Header="Type" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsSortedByKind, Mode=OneWay}"
                                          Command="{Binding ActiveTab.SortByKindCommand}"/>
                                <Separator/>
                                <MenuItem Header="Descending" ToggleType="CheckBox"
                                          IsChecked="{Binding ActiveTab.SortDescending, Mode=OneWay}"
                                          Command="{Binding ActiveTab.ToggleSortDirectionCommand}"/>
                              </MenuItem>
                <!-- **Only in Details, because that is the only view that can
                     draw the headings.** The RowGroup header is part of the
                     details row template; grid and compact lay out fixed-size
                     cells in a wrap panel, where a heading would sit inside a
                     cell rather than break the run. Grouping there still
                     reordered the tiles, silently and with nothing to say what
                     the runs were — the menu looked like it had done nothing.
                     Headings for the other two layouts are a real feature and a
                     different panel, not a gate. -->
                <MenuItem Header="Group by"
                                      IsVisible="{Binding ActiveTab.IsDetailsView}">
                                <MenuItem Header="None" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsUngrouped, Mode=OneWay}"
                                          Command="{Binding ActiveTab.GroupByNoneCommand}"/>
                                <Separator/>
                                <MenuItem Header="Name" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsGroupedByName, Mode=OneWay}"
                                          Command="{Binding ActiveTab.GroupByNameCommand}"/>
                                <MenuItem Header="Size" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsGroupedBySize, Mode=OneWay}"
                                          Command="{Binding ActiveTab.GroupBySizeCommand}"/>
                                <MenuItem Header="Modified" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsGroupedByModified, Mode=OneWay}"
                                          Command="{Binding ActiveTab.GroupByModifiedCommand}"/>
                                <MenuItem Header="Type" ToggleType="Radio"
                                          IsChecked="{Binding ActiveTab.IsGroupedByKind, Mode=OneWay}"
                                          Command="{Binding ActiveTab.GroupByKindCommand}"/>
                              </MenuItem>
              </MenuItem>
              <!-- **Two entries for one action, and only one is ever shown.**
                   Most machines have a single terminal, where a submenu holding
                   one row is a hover that buys nothing; a machine with Warp and
                   Windows Terminal and a Git Bash needs to be asked which. F4
                   opens the preferred one either way, so the direct route never
                   depends on which shape is showing. -->
              <MenuItem Header="Open terminal here"
                                      Command="{Binding ActiveTab.OpenTerminalHereCommand}"
                                      InputGesture="F4"
                                      IsVisible="{Binding !ActiveTab.HasSeveralTerminals}"/>
              <MenuItem x:Name="TerminalMenu" Header="Open terminal here"
                                      ItemsSource="{Binding ActiveTab.Terminals}"
                                      IsVisible="{Binding ActiveTab.HasSeveralTerminals}">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="fs:TerminalOption">
                                  <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem#TerminalMenu > MenuItem" x:DataType="fs:TerminalOption">
                                  <Setter Property="Command"
                                          Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.OpenTerminalInCommand}"/>
                                  <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
              <!-- **"More" is gone, not renamed.** It sat one row above the
                   hosted "More options" and the pair read as the same drawer
                   twice; nobody could say which held what. Its residents now
                   stand here under their own names, each pair collapsing to a
                   single visible row so the menu did not grow back. -->
              <MenuItem x:Name="ScriptsMenu" Header="Scripts" ItemsSource="{Binding ActiveTab.Scripts}"
                                      IsVisible="{Binding ActiveTab.HasScripts}">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="core:ScriptCommand">
                                  <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem#ScriptsMenu > MenuItem" x:DataType="core:ScriptCommand">
                                  <Setter Property="Command"
                                          Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.RunScriptCommand}"/>
                                  <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
              <!-- The other half of the Scripts pair: with no scripts installed
                   the submenu above is hidden and this row stands in its place,
                   saying what the feature is for and opening the folder that
                   starts it. No ellipsis: in this window that mark promises the
                   entry asks before it acts, and this one opens the folder
                   there and then. -->
              <MenuItem Header="Add your own scripts"
                                      Command="{Binding ActiveTab.OpenScriptsFolderCommand}"
                                      IsVisible="{Binding !ActiveTab.HasScripts}"/>
              <!-- Two commands, one visible row: pin the selected folder when
                   there is one, the folder you are looking at otherwise. Both
                   showing at once — the old behaviour — put "Add selection"
                   over "Add this folder" and made the reader work out which
                   acted on what. -->
              <MenuItem Header="Add to places"
                                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).AddSelectionToPlacesCommand}"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowAddSelectionToPlaces}"/>
              <MenuItem Header="Add this folder to places"
                                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).PinCurrentCommand}"
                                      InputGesture="Ctrl+D"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowAddCurrentToPlaces}"/>
              <!-- Gated on the one entry it introduces. Ungated it drew a rule
                   with nothing under it in every listing that is not the recent
                   one — which is most of them, including every ordinary folder —
                   and Avalonia does not collapse the double rule that made with
                   the one below. -->
              <!-- **Shift+right-click, the same gesture Explorer uses.**
                   Elevating is how somebody gets past a permission that was set
                   against them deliberately, so it belongs where it can be
                   reached and not where it can be stumbled into.

                   Vaktari never holds administrator rights itself: these ask
                   the SYSTEM to start a new process elevated, and the system
                   shows its own consent dialog and makes the decision. -->
              <!-- Only the admin TERMINAL keeps the Shift gate now — it is an
                   extended verb by Explorer's own convention. Run as
                   administrator moved to the top of the menu, ungated, where
                   Explorer keeps it. -->
              <Separator IsVisible="{Binding ActiveTab.ShowAdminEntries}"/>
              <MenuItem Header="Open admin terminal here"
                                      Command="{Binding ActiveTab.OpenAdminTerminalHereCommand}"
                                      IsVisible="{Binding ActiveTab.ShowAdminEntries}"/>
              <!-- **The machine's own menu: 7-Zip, VLC, Send to, Restore
                   previous versions.** Those are COM handlers registered by
                   installed applications, not a list anybody can write down, so
                   they can only be hosted.

                   Behind one hover rather than merged inline, and not for
                   tidiness: hosting runs OTHER PEOPLE'S code in this process. A
                   slow or broken extension becomes our slow or broken menu, and
                   confined here it can spoil this submenu instead of every
                   right-click. Windows 11 draws the same line for the same
                   reason.

                   Built when opened, never before — SubmenuOpened rather than a
                   binding — because building it gives every extension on the
                   machine a turn, and no ordinary right-click should pay for
                   that. Released when the menu closes: the ids are offsets into
                   one live menu and mean nothing afterwards. -->
              <!-- Named for what it IS, not for how much of it there is:
                   these rows come from Windows and the applications installed
                   on it, hosted here. Explorer's "Show more options" said
                   "more" without saying whose; this says whose. -->
              <MenuItem x:Name="ShellMenu" Header="Windows menu"
                                      IsVisible="{Binding ActiveTab.HasShellMenu}"
                                      ItemsSource="{Binding ActiveTab.ShellMenuItems}"
                                      SubmenuOpened="OnShellMenuOpening">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="fs:ShellMenuEntry">
                                  <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <!-- A DESCENDANT selector, not a child one: the
                                     shell's menu nests, and 7-Zip's own commands
                                     live a level down. Anchored on the name so it
                                     cannot match its own host — the fault that
                                     killed the New submenu. -->
                                <Style Selector="MenuItem#ShellMenu MenuItem" x:DataType="fs:ShellMenuEntry">
                                  <Setter Property="ItemsSource" Value="{Binding Items}"/>
                                  <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                  <Setter Property="Command"
                                          Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ActiveTab.InvokeShellEntryCommand}"/>
                                  <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
              <Separator IsVisible="{Binding ActiveTab.IsRecentListing}"/>
              <MenuItem Header="Forget (keeps the file)"
                                      IsVisible="{Binding ActiveTab.IsRecentListing}"
                                      Command="{Binding ActiveTab.ForgetRecentCommand}"/>
              <!-- Restore and the empty-bin entry are deliberately absent. The
                   trash listing docks both as buttons above the column header on
                   the same IsTrashListing gate these rows carried, so the menu
                   could only ever repeat a pair of controls already on screen. -->
              <Separator/>
              <MenuItem Header="Properties"
                                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowPropertiesCommand}"
                                      IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CanShowProperties}"
                                      InputGesture="Alt+Enter"/>
            </ContextMenu>
          </ItemsControl.ContextMenu>

          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Grid/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PaneViewModel">
              <!-- Every pane's view stays alive, toggled by IsVisible rather
                   than swapped through a ContentControl, so switching tabs
                   never resets scroll position. -->
              <!-- PaneScale writes THIS pane's metrics into this control's own
                   resources. A DynamicResource resolves nearest-outward, so
                   everything below here uses the pane's sizes, while the
                   sidebar and status bar keep the application defaults — and
                   the other side of a split keeps its own. -->
              <Panel local:PaneScale.Pane="{Binding}"
                     IsVisible="{Binding IsActive}" DragDrop.AllowDrop="True">

              <DockPanel>


              <!-- Trash actions. Docked ABOVE the column header so it shows in
                   every layout, not just details — the header itself is bound to
                   IsDetailsView and would have hidden these in grid and compact.
                   The whole band only exists in the trash listing. -->
              <Border DockPanel.Dock="Top" Padding="12,6"
                      Background="{DynamicResource ChromeBrush}"
                      BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorColour}"
                      IsVisible="{Binding IsTrashListing}">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                  <Button Content="Restore"
                          Command="{Binding RestoreFromTrashCommand}"
                          FontSize="{DynamicResource FontSizeSmall}" Padding="10,3"
                          AutomationProperties.Name="put the selected items back where they came from" ToolTip.Tip="put the selected items back where they came from"/>
                  <!-- The ellipsis is a promise: this one asks first. It is the
                       only action in the application with neither an undo nor a
                       per-item review, so it never fires straight from a click. -->
                  <Button Content="{Binding $parent[Window].((vm:ShellViewModel)DataContext).BinEmptyLabel}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).EmptyTrashCommand}"
                          FontSize="{DynamicResource FontSizeSmall}" Padding="10,3"
                          AutomationProperties.Name="{Binding $parent[Window].((vm:ShellViewModel)DataContext).BinEmptyHint}" ToolTip.Tip="{Binding $parent[Window].((vm:ShellViewModel)DataContext).BinEmptyHint}"/>
                </StackPanel>
              </Border>

              <!-- Below the chain, because it labels the listing rather than
                   the strip. Column widths and margin match the row template so
                   the headings actually sit over their columns. -->
              <!-- The header is a raised band: highlight above, shadow below.
                   Without it the column labels float on the same plane as the
                   rows they describe. -->
              <Border DockPanel.Dock="Top" Padding="0,4" Background="{DynamicResource ChromeBrush}"
                      BorderThickness="0,1,0,1" BorderBrush="{DynamicResource SeparatorColour}"
                      IsVisible="{Binding IsDetailsView}">
                <!-- **Which columns to show, where both Explorer and Dolphin
                     put it: right-click the headings.** On the header rather
                     than in the listing menu because that is where somebody
                     reaches for it, and because the listing menu does not need
                     another row to reach a thing you can already see.

                     The choice belongs to THIS pane, the way its sort and
                     grouping do: a reference listing beside a working one wants
                     different columns, and ticking one on the left must not
                     move the right. So it binds straight to the pane under it.
                     OneWay IsChecked plus a Command, never a TwoWay binding —
                     the same shape as every other tick here.

                     Name has no toggle. Explorer greys it out for the same
                     reason: a listing of sizes with no names is not a listing
                     of anything. It is shown ticked and disabled rather than
                     left out, so the menu says what the columns ARE rather than
                     only what can be changed about them. -->
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Name" ToggleType="CheckBox" IsChecked="True" IsEnabled="False"/>
                    <MenuItem Header="Type"
                              ToggleType="CheckBox"
                              IsChecked="{Binding IsTypeColumnShown, Mode=OneWay}"
                              Command="{Binding ToggleTypeColumnCommand}"/>
                    <MenuItem Header="Size"
                              ToggleType="CheckBox"
                              IsChecked="{Binding IsSizeColumnShown, Mode=OneWay}"
                              Command="{Binding ToggleSizeColumnCommand}"/>
                    <MenuItem Header="Modified"
                              ToggleType="CheckBox"
                              IsChecked="{Binding IsModifiedColumnShown, Mode=OneWay}"
                              Command="{Binding ToggleModifiedColumnCommand}"/>
                    <Separator/>
                    <!-- Says the other half out loud. A ticked column that is
                         not on screen looks like a bug, and this is the one
                         place somebody is looking when they wonder why. -->
                    <MenuItem Header="A narrow pane drops columns to keep the name readable."
                              IsEnabled="False"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <!-- Headings sort. The sort state existed, was persisted per
                     tab, and had no control anywhere that could set it. -->
                <Grid Margin="12,0,18,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="{DynamicResource ThumbSize}" Margin="0,0,8,0"/>
                  <Button Grid.Column="1" Command="{Binding SortByCommand}" CommandParameter="name"
                          AutomationProperties.Name="sort by name"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ViewDimText}">
                      <Run Text="name"/><Run Text="{Binding NameSortGlyph}"/>
                    </TextBlock>
                  </Button>
                  <!-- Column 2 is the recent listing's "path" only. It used to
                       share the slot with an "info" column carrying a
                       type-specific fact; that one is gone. -->
                  <TextBlock Grid.Column="2" Width="{DynamicResource ColPathWide}" Margin="8,0,0,0" Text="path"
                             IsVisible="{Binding ShowParentPath}"
                             FontSize="{DynamicResource FontSizeSmall}"
                             Foreground="{DynamicResource ViewDimText}"/>
                  <!-- Column 3 stood empty in both grids: the slot the old
                       "info" column left behind. The type column lands in it
                       without renumbering anything after it, which is the edit
                       the row template warns goes wrong quietly. -->
                  <Button Grid.Column="3" Width="{DynamicResource ColType}" Margin="8,0,0,0"
                          Command="{Binding SortByCommand}" CommandParameter="kind"
                          AutomationProperties.Name="sort by type"
                          IsVisible="{Binding ShowType}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Left">
                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ViewDimText}">
                      <Run Text="type"/><Run Text="{Binding KindSortGlyph}"/>
                    </TextBlock>
                  </Button>
                  <Button Grid.Column="4" Width="{DynamicResource ColSize}" Command="{Binding SortByCommand}" CommandParameter="size"
                          AutomationProperties.Name="sort by size"
                          IsVisible="{Binding ShowSize}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Right">
                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ViewDimText}">
                      <Run Text="size"/><Run Text="{Binding SizeSortGlyph}"/>
                    </TextBlock>
                  </Button>
                  <Button Grid.Column="5" Width="{DynamicResource ColModified}" Command="{Binding SortByCommand}" CommandParameter="modified"
                          AutomationProperties.Name="sort by date modified"
                          IsVisible="{Binding ShowModified}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Right">
                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ViewDimText}">
                      <Run Text="modified"/><Run Text="{Binding ModifiedSortGlyph}"/>
                    </TextBlock>
                  </Button>
                </Grid>
              </Border>

              <!-- Both layouts share one slot: in a DockPanel only the last child
                   fills, so two bare siblings would dock the list to the left. -->
              <Panel>
              <ListBox ItemsSource="{Binding DetailsEntries}"
                       SelectedItem="{Binding SelectedEntry}"
                       SelectedItems="{Binding DetailsSelection}"
                       DragDrop.AllowDrop="True"
                       SizeChanged="OnListSizeChanged"
                       Focusable="True"
                       IsVisible="{Binding IsDetailsView}" SelectionMode="Multiple" Background="Transparent" Padding="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                  </Style>
                  <!-- Banding, from the desktop's own alternate-row colour. It was being
                       read out of kdeglobals and thrown away, which is much of why a long
                       listing read as a single flat sheet. -->
                  <Style Selector="ListBoxItem:nth-child(even) /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ViewAlternate}"/>
                  </Style>
                  <!-- Hover wash. Declared before the selection rules so selection wins. -->
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                  </Style>
                  <!-- The theme's own selection fill is suppressed; the row template draws
                       the cue, so it is guaranteed to appear. -->
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>

                  <!-- **The secondary columns keep their dim colour over the
                       selection fill**, which drops them to 3.40:1 in the dark
                       theme and 4.30:1 in the light one — both under AA, on the
                       row the user is actually looking at. The dim grey was
                       chosen against the listing ground, not against the
                       accent. Full text colour while the row is selected: the
                       columns are secondary to the NAME, not to the row. -->
                  <Style Selector="ListBoxItem:selected TextBlock.meta">
                    <Setter Property="Foreground" Value="{DynamicResource ViewText}"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="fs:FileEntry">
                    <StackPanel>
                      <!-- Greyed while cut and not yet pasted, as Explorer does.
                           Binding the SET rather than a per-row flag is what
                           makes every visible row re-evaluate the moment
                           something is cut. -->
                      <StackPanel.Opacity>
                        <MultiBinding Converter="{x:Static vm:FileConverters.CutFade}">
                          <Binding Path="FullPath"/>
                          <Binding Path="$parent[Window].((vm:ShellViewModel)DataContext).CutPaths"/>
                        </MultiBinding>
                      </StackPanel.Opacity>
                      <!-- Group header, shown only on the first row of each run.
                           Part of the row rather than a separate list item, so
                           Entries stays a flat list of FileEntry and selection,
                           virtualization and the three layouts all keep working. -->
                      <ContentControl th:RowGroup.Entry="{Binding}"
                                      IsVisible="False"
                                      Margin="12,8,8,2"
                                      FontSize="{DynamicResource FontSizeSmall}"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource ViewDimText}"/>
                    <!-- **Transparent, so the whole row can be clicked.** A Panel
                         with no Background is not hit-testable in Avalonia:
                         pointer events pass straight through it. Only the
                         TextBlocks were targets, so a double-click landed on a
                         name or an icon or on nothing at all — and the row is
                         mostly nothing, since a filename rarely fills it.

                         That is the "opening a folder feels delayed" report.
                         Nothing was slow: measured from the physical press, a
                         hit on the name opens in 0 ms and lists in 31 ms. A
                         miss does not open at all, so it reads as lag rather
                         than as a dead zone, and the fix for lag — click again
                         — eventually works by luck.

                         It also explains why selection seemed to help: once
                         selected, the AccentDim border below becomes visible,
                         and a visible background IS hit-testable. So the row
                         went from dead to live after the first successful
                         click, which is a strange thing to notice and an easy
                         thing to misread as a timing problem. -->
                    <Panel Background="Transparent">
                      <!-- Selection marker drawn by us rather than by the control theme.
                           A 3px bar plus a fill means selection reads by position as well
                           as by colour, which the theme default does not. -->
                      <Border Background="{DynamicResource AccentDim}"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}" IsHitTestVisible="False"/>
                      <Border Width="3" HorizontalAlignment="Left"
                              Background="{DynamicResource AccentColour}"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}" IsHitTestVisible="False"/>
                      <Grid Height="{DynamicResource RowHeight}" Margin="12,0,18,0" ClipToBounds="True">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- The name takes all slack so the metadata block sits
                             flush against the pane's right edge, the way every
                             file manager does it. Truncation is handled in the
                             cell itself, not by capping the column. -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                    <Panel Grid.Column="0" Width="{DynamicResource ThumbSize}"
                           Height="{DynamicResource ThumbSize}" Margin="0,0,8,0"
                           VerticalAlignment="Center">
                      <!-- Two layers only: the icon (themed, or the drawn glyph
                           as its own fallback source) and a thumbnail over it,
                           which hides itself when there is none. -->
                      <Image th:RowIcon.Entry="{Binding}" th:RowIcon.Size="32"
                             Stretch="Uniform"/>
                      <Image th:ThumbnailImage.Path="{Binding FullPath}"
                             th:ThumbnailImage.Size="64" Stretch="Uniform"/>
                    </Panel>
                        <!-- DockPanel, not StackPanel: a horizontal StackPanel gives
                             its children unlimited width, so TextTrimming can never
                             fire and a long name renders straight over the next
                             column. Docking the chips first leaves the name a real
                             width to trim into. -->
                        <DockPanel Grid.Column="1" VerticalAlignment="Center"
                                   ClipToBounds="True">
                          <!-- Version-control marker. The LETTER carries the meaning and
                               the colour is decoration, never the only signal: hue
                               alone would be invisible to a colourblind reader.
                               Fixed width so names stay aligned whether or not a row is
                               marked, and the whole column only exists inside a
                               repository. -->
                          <TextBlock DockPanel.Dock="Left" Width="11" Margin="0,0,5,0"
                                     th:RowVcs.Entry="{Binding}"
                                     IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).IsRepository}"
                                     FontSize="{DynamicResource FontSizeSmall}"
                                     FontWeight="Bold" TextAlignment="Center"
                                     VerticalAlignment="Center"/>
                          <!-- Left, not stretched. As the DockPanel's fill child this
                               claimed the entire name column, so the gap beside a short
                               filename was still the label — there was nothing in a row
                               to grab for a rubber band. Trimming still fires: a
                               Left-aligned child is measured against the available width
                               and clamped to it. -->
                          <!-- **The name was the one trimmed thing with nothing to
                               say what it trimmed.** Every other column in the row
                               tips; this one ellipsizes and stayed unreadable, so a
                               long name in a narrow pane could only be read by
                               pressing F2 and then Escape.

                               A long delay, not the usual hover speed: the tip
                               repeats the label whenever the name DOES fit, and a
                               tooltip that pops over text you can already read is
                               noise. Same 1200ms the address bar uses for its own
                               duplicate-of-visible-text tip.

                               On the TextBlock and not the row: over blank row
                               space, or over the size and modified cells, a
                               different tip is the right answer. -->
                          <TextBlock Text="{Binding Converter={x:Static vm:FileConverters.DisplayName}}" HorizontalAlignment="Left"
                                     FontSize="{DynamicResource FontSizeBase}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Converter={x:Static vm:FileConverters.NameTip}}"
                                     ToolTip.ShowDelay="1200"
                                     Opacity="{Binding Converter={x:Static vm:FileConverters.HiddenFade}}"/>

                          <!-- **Two files can sit here looking identically
                               named.** One space before the extension is legal,
                               distinct to the filesystem, and unreadable in any
                               listing including Explorer's — so the row says so
                               rather than leaving somebody to wonder why there
                               are two of something.

                               Docked after the name, so it sits beside a short
                               one rather than at the far edge of the column. -->
                          <TextBlock Text="look-alike"
                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                     FontSize="{DynamicResource FontSizeTiny}"
                                     Foreground="{DynamicResource AccentText}"
                                     ToolTip.Tip="Another name here differs only by spacing or capitals.">
                            <TextBlock.IsVisible>
                              <MultiBinding Converter="{x:Static vm:FileConverters.Confusable}">
                                <Binding Path="FullPath"/>
                                <Binding Path="$parent[ListBox].((vm:PaneViewModel)DataContext).Confusable"/>
                              </MultiBinding>
                            </TextBlock.IsVisible>
                          </TextBlock>
                        </DockPanel>
                        <!-- Where the row actually lives. Only in a recent
                             listing, where entries span the filesystem and the
                             name alone identifies nothing. -->
                        <TextBlock Grid.Column="2" Width="{DynamicResource ColPathWide}" Margin="8,0,0,0"
                                   Classes="meta" Text="{Binding Converter={x:Static vm:FileConverters.ParentPath}}"
                                   ToolTip.Tip="{Binding Converter={x:Static vm:FileConverters.PathTip}}"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowParentPath}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource ViewDimText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- The extension, spelled the way Explorer spells it
                             when it has nothing better. Synchronous on purpose:
                             both platforms can name a file's type properly and
                             both do it per file and asynchronously, which is not
                             something a column can be filled from while it
                             scrolls. -->
                        <TextBlock Grid.Column="3" Width="{DynamicResource ColType}" Margin="8,0,0,0"
                                   Classes="meta" Text="{Binding Converter={x:Static vm:FileConverters.Kind}}"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowType}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource ViewDimText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="4" Width="{DynamicResource ColSize}" Classes="meta" Text="{Binding Converter={x:Static vm:FileConverters.Size}}" TextAlignment="Right"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowSize}"
                                   FontSize="{DynamicResource FontSizeSmall}" FontFamily="{DynamicResource AppMonoFamily}" Foreground="{DynamicResource ViewDimText}"
                                   VerticalAlignment="Center"/>
                        <!-- Shaded by age: a single-hue lightness ramp, and the date itself
                             is still right there, so the colour is a shortcut rather than
                             the only signal. -->
                        <TextBlock Grid.Column="5" Width="{DynamicResource ColModified}" Classes="meta" Text="{Binding LastWriteTime, Converter={x:Static vm:FileConverters.Modified}}" TextAlignment="Right"
                                   IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).ShowModified}"
                                   Foreground="{Binding LastWriteTime, Converter={x:Static vm:AgeConverters.Brush}}"
                                   ToolTip.Tip="{Binding LastWriteTime, Converter={x:Static vm:AgeConverters.Description}}"
                                   FontSize="{DynamicResource FontSizeSmall}" FontFamily="{DynamicResource AppMonoFamily}"
                                   VerticalAlignment="Center"/>
                      </Grid>
                      <!-- **Where the drop lands.** The pane took an outline while a drag
                           was over it, and which pane the pointer is in was never the
                           question; what a drag could not tell you is whether releasing
                           puts the files into the folder under the pointer or into the
                           folder being listed. Constant thickness with a transparent
                           brush when this is not the target, so the row you are aiming
                           at does not move while you aim at it. -->
                      <Border IsHitTestVisible="False" CornerRadius="3" BorderThickness="1.4">
                        <Border.BorderBrush>
                          <MultiBinding Converter="{x:Static vm:FileConverters.DropRingBrush}">
                            <Binding Path="FullPath"/>
                            <Binding Path="$parent[ListBox].((vm:PaneViewModel)DataContext).DropTargetPath"/>
                          </MultiBinding>
                        </Border.BorderBrush>
                      </Border>
                    </Panel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Compact layout: names only, flowing DOWN and wrapping into
                   columns, which is why the ScrollViewer scrolls horizontally.
                   A third ListBox for the same reason as the second — the
                   panel and the item template change together, and three lists
                   binding one selection are simpler than one that rewrites
                   itself twice. -->
              <ListBox ItemsSource="{Binding CompactEntries}"
                       SelectedItem="{Binding SelectedEntry}"
                       SelectedItems="{Binding CompactSelection}"
                       IsVisible="{Binding IsCompactView}"
                       DragDrop.AllowDrop="True"
                       Focusable="True"
                       SelectionMode="Multiple" Background="Transparent" Padding="4"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- Vertical wrap is what makes it columns rather than rows.
                         **Now the SAME panel the grid uses**, in its vertical
                         orientation — items run down a column and wrap across,
                         and only the visible columns are realized. The plain
                         WrapPanel it replaces took 32 seconds on 100,000 items
                         because it realized every one of them.
                         ItemWidth/ItemHeight are the CELL, which already carries
                         the user's spacing, so ItemSpacing stays at its default
                         and the row inside keeps its own size. -->
                    <local:VirtualizingWrapPanel
                        Orientation="Vertical"
                        ItemWidth="{DynamicResource CompactCellWidth}"
                        ItemHeight="{DynamicResource CompactCellHeight}"
                        ItemSpacing="0"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="fs:FileEntry">
                    <!-- Outer cell carries the user's spacing; the row inside
                         keeps its own size, so the selection highlight hugs the
                         row rather than stretching across the gap. -->
                    <!-- Hit-testable: see the details row. -->
                    <Panel Background="Transparent" Width="{DynamicResource CompactCellWidth}"
                           Height="{DynamicResource CompactCellHeight}">
                      <!-- Greyed while cut and not yet pasted, as Explorer does.
                           Binding the SET rather than a per-row flag is what
                           makes every visible row re-evaluate the moment
                           something is cut. -->
                      <Panel.Opacity>
                        <MultiBinding Converter="{x:Static vm:FileConverters.CutFade}">
                          <Binding Path="FullPath"/>
                          <Binding Path="$parent[Window].((vm:ShellViewModel)DataContext).CutPaths"/>
                        </MultiBinding>
                      </Panel.Opacity>
                      <Panel Width="{DynamicResource CompactWidth}"
                             Height="{DynamicResource CompactRowHeight}"
                             HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border Background="{DynamicResource AccentDim}" CornerRadius="4"
                                Margin="1" IsVisible="{Binding $parent[ListBoxItem].IsSelected}" IsHitTestVisible="False"/>
                        <!-- Same edge bar as the details rows: selection must read
                             by position as well as by colour. -->
                        <Border Width="3" HorizontalAlignment="Left" Margin="1"
                                Background="{DynamicResource AccentColour}"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}" IsHitTestVisible="False"/>
                        <DockPanel VerticalAlignment="Center" Margin="6,0,6,0">
                          <!-- Same slot and same rules as the details column:
                               fixed width so names stay aligned marked or not,
                               and the whole slot only exists in a repository. -->
                          <TextBlock Width="11" th:RowVcs.Entry="{Binding}"
                                     IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).IsRepository}"
                                     FontSize="{DynamicResource FontSizeSmall}"
                                     FontWeight="Bold" TextAlignment="Center"
                                     VerticalAlignment="Center"/>
                          <!-- Compact's OWN icon metric, not the details one.
                               Measured against Dolphin, a compact icon is about
                               double the text line height and the row hugs it.
                               Borrowing ThumbSize gave a details-shaped row with
                               an undersized icon in it — neither mode's
                               proportions. Requested at 48 so the source is never
                               smaller than the box. -->
                          <!-- Margins rather than the StackPanel's Spacing="8",
                               which a DockPanel has no equivalent for. -->
                          <Panel Width="{DynamicResource CompactIconSize}"
                                 Height="{DynamicResource CompactIconSize}"
                                 Margin="8,0">
                            <Image th:RowIcon.Entry="{Binding}" th:RowIcon.Size="48"
                                   Stretch="Uniform"/>
                          </Panel>
                          <!-- Same mark, same words as the details row — it
                               was details-only, so switching view silently
                               hid the one warning about two names that read
                               identically. Right-docked so it survives a long
                               name; the name ellipsizes, the warning does not. -->
                          <TextBlock DockPanel.Dock="Right" Text="look-alike"
                                     Margin="6,0,2,0" VerticalAlignment="Center"
                                     FontSize="{DynamicResource FontSizeTiny}"
                                     Foreground="{DynamicResource AccentText}"
                                     ToolTip.Tip="Another name here differs only by spacing or capitals.">
                            <TextBlock.IsVisible>
                              <MultiBinding Converter="{x:Static vm:FileConverters.Confusable}">
                                <Binding Path="FullPath"/>
                                <Binding Path="$parent[ListBox].((vm:PaneViewModel)DataContext).Confusable"/>
                              </MultiBinding>
                            </TextBlock.IsVisible>
                          </TextBlock>
                          <!-- The icon docks, the name takes what is left. In
                               the StackPanel this replaced, the name was
                               measured with infinite width and its ellipsis
                               never appeared — a long filename in compact view
                               simply ran past the cell and was clipped. -->
                          <!-- Trims, so it tips. See the details row. -->
                          <TextBlock Text="{Binding Converter={x:Static vm:FileConverters.DisplayName}}" VerticalAlignment="Center"
                                     FontSize="{DynamicResource FontSizeBase}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Converter={x:Static vm:FileConverters.NameTip}}"
                                     ToolTip.ShowDelay="1200"/>
                        </DockPanel>
                      </Panel>
                      <!-- **Where the drop lands.** The pane took an outline while a drag
                           was over it, and which pane the pointer is in was never the
                           question; what a drag could not tell you is whether releasing
                           puts the files into the folder under the pointer or into the
                           folder being listed. Constant thickness with a transparent
                           brush when this is not the target, so the row you are aiming
                           at does not move while you aim at it. -->
                      <Border IsHitTestVisible="False" CornerRadius="3" BorderThickness="1.4">
                        <Border.BorderBrush>
                          <MultiBinding Converter="{x:Static vm:FileConverters.DropRingBrush}">
                            <Binding Path="FullPath"/>
                            <Binding Path="$parent[ListBox].((vm:PaneViewModel)DataContext).DropTargetPath"/>
                          </MultiBinding>
                        </Border.BorderBrush>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Grid layout. A separate ListBox rather than a swapped ItemsPanel: the
                   panel and the item template change together, and two lists binding one
                   selection are simpler than one list rewriting itself. -->
              <ListBox ItemsSource="{Binding GridEntries}"
                       SelectedItem="{Binding SelectedEntry}"
                       SelectedItems="{Binding GridSelection}"
                       IsVisible="{Binding IsGridView}"
                       DragDrop.AllowDrop="True"
                       Focusable="True"
                       SelectionMode="Multiple" Background="Transparent" Padding="6">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- Grid is the first layout on the virtualizing panel.
                         Compact deliberately stays on the plain WrapPanel below,
                         as a control: if grid misbehaves, the difference between
                         the two is the evidence.

                         ItemWidth/ItemHeight are the TILE; the panel adds
                         ItemSpacing to get the cell, matching the Margin="3" in
                         the item template. -->
                    <local:VirtualizingWrapPanel
                        ItemWidth="{DynamicResource TileWidth}"
                        ItemHeight="{DynamicResource TileHeight}"
                        ItemSpacing="{DynamicResource TileSpacing}"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="fs:FileEntry">
                    <!-- Hit-testable: see the details row. -->
                    <Panel Background="Transparent" Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}" Margin="3">
                      <!-- Greyed while cut and not yet pasted, as Explorer does.
                           Binding the SET rather than a per-row flag is what
                           makes every visible row re-evaluate the moment
                           something is cut. -->
                      <Panel.Opacity>
                        <MultiBinding Converter="{x:Static vm:FileConverters.CutFade}">
                          <Binding Path="FullPath"/>
                          <Binding Path="$parent[Window].((vm:ShellViewModel)DataContext).CutPaths"/>
                        </MultiBinding>
                      </Panel.Opacity>
                      <Border Background="{DynamicResource AccentDim}" CornerRadius="6"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}" IsHitTestVisible="False"/>
                      <!-- A tile has no left edge to bar, so selection gets an outline —
                           same principle as the row marker, different geometry. -->
                      <Border BorderBrush="{DynamicResource AccentColour}" BorderThickness="2" CornerRadius="6"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}" IsHitTestVisible="False"/>
                      <StackPanel Margin="8,6" VerticalAlignment="Top" Spacing="2">
                        <Panel Width="{DynamicResource TileSize}" Height="{DynamicResource TileSize}"
                               HorizontalAlignment="Center">
                          <Image th:RowIcon.Entry="{Binding}" th:RowIcon.Size="64"
                                 Stretch="Uniform" VerticalAlignment="Bottom"/>
                          <Image th:ThumbnailImage.Path="{Binding FullPath}"
                                 th:ThumbnailImage.Size="256" Stretch="Uniform"
                                 VerticalAlignment="Bottom"/>
                          <!-- A tile has no column to keep aligned, so unlike
                               details and compact this DISAPPEARS when the file
                               is clean rather than reserving an empty slot —
                               `RowVcs.Badge` on the border, `RowVcs.Entry` on
                               the letter inside it.
                               The filled background is not decoration: the mark
                               sits on top of a thumbnail, and a bare glyph over
                               a photograph is unreadable at any colour. -->
                          <Border th:RowVcs.Badge="{Binding}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Background="{DynamicResource ViewBackground}"
                                  CornerRadius="3" Padding="4,0" Margin="0,0,2,2">
                            <TextBlock th:RowVcs.Entry="{Binding}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="Bold"/>
                          </Border>
                          <!-- The look-alike mark, tile edition. A tile has no
                               row to append the word to, so it borrows the VCS
                               badge's geometry in the opposite corner — filled,
                               because it can sit on a thumbnail, and "≈"
                               because that is the claim: nearly the same. The
                               tooltip carries the words. -->
                          <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Background="{DynamicResource AccentColour}"
                                  CornerRadius="3" Padding="5,0" Margin="2,2,0,0"
                                  ToolTip.Tip="Another name here differs only by spacing or capitals.">
                            <Border.IsVisible>
                              <MultiBinding Converter="{x:Static vm:FileConverters.Confusable}">
                                <Binding Path="FullPath"/>
                                <Binding Path="$parent[ListBox].((vm:PaneViewModel)DataContext).Confusable"/>
                              </MultiBinding>
                            </Border.IsVisible>
                            <TextBlock Text="&#x2248;" FontWeight="Bold"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ViewBackground}"/>
                          </Border>
                        </Panel>
                        <!-- Two lines and then an ellipsis, so this one hides the
                             most of all. See the details row. -->
                        <TextBlock Text="{Binding Converter={x:Static vm:FileConverters.DisplayName}}" TextAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Converter={x:Static vm:FileConverters.NameTip}}"
                                   ToolTip.ShowDelay="1200"/>
                      </StackPanel>
                      <!-- **Where the drop lands.** The pane took an outline while a drag
                           was over it, and which pane the pointer is in was never the
                           question; what a drag could not tell you is whether releasing
                           puts the files into the folder under the pointer or into the
                           folder being listed. Constant thickness with a transparent
                           brush when this is not the target, so the row you are aiming
                           at does not move while you aim at it. -->
                      <Border IsHitTestVisible="False" CornerRadius="3" BorderThickness="1.4">
                        <Border.BorderBrush>
                          <MultiBinding Converter="{x:Static vm:FileConverters.DropRingBrush}">
                            <Binding Path="FullPath"/>
                            <Binding Path="$parent[ListBox].((vm:PaneViewModel)DataContext).DropTargetPath"/>
                          </MultiBinding>
                        </Border.BorderBrush>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </Panel>

              </DockPanel>

              <!-- An empty listing looked identical to one still loading. -->
              <TextBlock Text="{Binding EmptyText}"
                         IsVisible="{Binding IsEmpty}" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeBase}"
                         Foreground="{DynamicResource ViewDimText}"/>

              <!-- **And a filter that matched nothing said the same thing**,
                   which over a folder full of files reads as data loss — and
                   the way out, clearing the filter, was the one thing the
                   message gave no reason to try. It names the filter, because
                   the box may be somewhere the eye is not. -->
              <TextBlock Text="{Binding NoMatchesLine}"
                         IsVisible="{Binding HasNoMatches}" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeBase}"
                         Foreground="{DynamicResource ViewDimText}"/>

              <!-- And a listing that FAILED looked identical to both. A tab
                   whose folder has been deleted drew column headings over
                   nothing, with its only explanation in a status bar that
                   describes whichever pane is active — so in the other half of
                   a split there was no message at all. -->
              <TextBlock Text="{Binding LoadError}"
                         IsVisible="{Binding HasLoadError}" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center"
                         FontSize="{DynamicResource FontSizeBase}"
                         Foreground="{DynamicResource ViewDimText}"/>

              <!-- Drop target outline. Hit-testing is off so it never eats the
                   drag events it is drawn in response to. -->
              <Border IsVisible="{Binding IsDropTarget}" IsHitTestVisible="False"
                      BorderThickness="2" BorderBrush="{DynamicResource AccentColour}"/>

              <!-- Preview sits over the listing rather than beside it: at this
                   width a side panel would squeeze the list to nothing, and
                   the overlay dismisses with the same key that opened it. -->
              <Border IsVisible="{Binding IsPreviewVisible}"
                      Background="{DynamicResource ViewBackground}" BorderThickness="0.5,0,0,0"
                      BorderBrush="{DynamicResource SeparatorColour}" HorizontalAlignment="Right"
                      Width="360" Padding="12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="{DynamicResource FontSizeLarge}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PreviewDetail}" FontSize="{DynamicResource FontSizeTiny}"
                               Foreground="{DynamicResource ViewDimText}" FontFamily="monospace"/>
                  </StackPanel>

                  <Image Source="{Binding PreviewImage}"
                         IsVisible="{Binding HasPreviewImage}"
                         Stretch="Uniform" VerticalAlignment="Top"/>

                  <ScrollViewer IsVisible="{Binding HasPreviewText}">
                    <TextBlock Text="{Binding PreviewText}" FontSize="{DynamicResource FontSizeSmall}"
                               FontFamily="monospace" TextWrapping="NoWrap"
                               Opacity="0.75"/>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>

        </ItemsControl>

      </DockPanel>
    </DataTemplate>

  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+T"         Command="{Binding NewTabCommand}"/>
    <KeyBinding Gesture="Ctrl+W"         Command="{Binding CloseTabCommand}"/>
    <!-- What every browser answers, and both references. Closing a tab used to
         throw its state away, so there was nothing to put back. -->
    <KeyBinding Gesture="Ctrl+Shift+T"   Command="{Binding ReopenClosedTabCommand}"/>
    <KeyBinding Gesture="Ctrl+Q"         Command="{Binding QuitCommand}"/>
    <KeyBinding Gesture="Ctrl+Tab"       Command="{Binding NextTabCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}"/>
    <KeyBinding Gesture="Alt+Home"       Command="{Binding ActiveTab.GoHomeCommand}"/>
    <KeyBinding Gesture="Alt+Left"       Command="{Binding ActiveTab.GoBackCommand}"/>
    <KeyBinding Gesture="Alt+Right"      Command="{Binding ActiveTab.GoForwardCommand}"/>
    <KeyBinding Gesture="Alt+Up"         Command="{Binding ActiveTab.GoUpCommand}"/>
    <KeyBinding Gesture="F5"             Command="{Binding ActiveTab.RefreshCommand}"/>
    <KeyBinding Gesture="F2"             Command="{Binding ActiveTab.BeginRenameCommand}"/>
    <KeyBinding Gesture="Shift+F2"       Command="{Binding BatchRenameCommand}"/>
    <KeyBinding Gesture="F11"            Command="{Binding ToggleInfoCommand}"/>
    <!-- Every key this application answers, in one place. It calls itself
         keyboard-friendly and had nowhere to look them up. -->
    <KeyBinding Gesture="F1"             Command="{Binding ShowShortcutsCommand}"/>
    <KeyBinding Gesture="F3"             Command="{Binding ToggleSplitCommand}"/>
    <KeyBinding Gesture="F8"             Command="{Binding ActiveTab.ToggleViewCommand}"/>
    <!-- Space is NOT here. It is handled in OnWindowKeyDown, which is the only
         place the text-box and rename guards can reach it: a KeyBinding is
         dispatched by the window ahead of that handler, so Space toggled the
         preview while somebody was typing a filename. -->
    <KeyBinding Gesture="F4"             Command="{Binding ActiveTab.OpenTerminalHereCommand}"/>
    <!-- **The six gestures a text cursor owns are NOT here.** They are handled
         in OnWindowKeyDown, for exactly the reason Space is, and the fault was
         the same one this file already warns about four lines up.

         Ctrl+C, Ctrl+X and Ctrl+V lived here, so the address bar could not copy
         or paste: the window claimed the keystroke before the focused TextBox
         ever saw it. Ctrl+V pasted FILES into the folder behind the box, Ctrl+X
         armed a move of whatever was selected in the listing, and Ctrl+C
         replaced the system clipboard with that selection — so copying a path
         out of the address bar destroyed the thing you were copying it into.

         Ctrl+Z and both redo spellings went the same way, and worse: undo while
         mistyping a path reversed the last copy, move or delete ON DISK. The
         comment that used to sit here called Ctrl+Shift+Z "what everything with
         a text cursor answers", which is precisely why binding it window-wide
         stopped the one text cursor that wanted it.

         Ctrl+A is deliberately absent for the same reason and always was.
         Shift+Insert, Ctrl+Insert and Shift+Delete are the same commands under
         their older names; those were never bound here, which is why they kept
         working in the address bar the whole time. -->
    <KeyBinding Gesture="Ctrl+I"         Command="{Binding ActiveTab.ToggleFilterCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+N"   Command="{Binding ActiveTab.NewFolderCommand}"/>
    <KeyBinding Gesture="Ctrl+OemPlus"   Command="{Binding ZoomInCommand}"/>
    <KeyBinding Gesture="Ctrl+OemMinus"  Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Gesture="Ctrl+D0"        Command="{Binding ZoomResetCommand}"/>
    <KeyBinding Gesture="Ctrl+B"         Command="{Binding Sidebar.CycleRailCommand}"/>
    <!-- Dolphin's own gesture for the same panel, and free here. -->
    <KeyBinding Gesture="F9"            Command="{Binding Sidebar.CycleRailCommand}"/>
    <!-- Ctrl+H is what every file manager on this desktop uses for hidden files;
         it existed only as a checkbox in the layout flyout. -->
    <KeyBinding Gesture="Ctrl+H"         Command="{Binding ActiveTab.ToggleHiddenCommand}"/>
    <KeyBinding Gesture="Ctrl+D"         Command="{Binding PinCurrentCommand}"/>
    <!-- The gesture Windows uses for the same action, so the menu can show it
         without inventing one. Added WITH the menu entry: a shortcut printed
         beside a row and bound to nothing is worse than no shortcut at all. -->
    <KeyBinding Gesture="Ctrl+Shift+C"   Command="{Binding CopyLocationCommand}"/>
    <!-- Alt rather than Ctrl for panels: Ctrl+1..9 already switches tabs,
         browser-style, and that convention is the stronger one. -->
    <KeyBinding Gesture="Ctrl+F"         Command="{Binding Sidebar.FocusSearchCommand}"/>
    <!-- Ctrl+E is what Explorer binds search to; Ctrl+F is what
         everything else does. Both, for the same reason as Alt+D. -->
    <KeyBinding Gesture="Ctrl+E"         Command="{Binding Sidebar.FocusSearchCommand}"/>
    <KeyBinding Gesture="Ctrl+L"         Command="{Binding ActiveTab.BeginEditPathCommand}"/>
    <!-- Alt+D is the other half of the same habit: Explorer and every
         browser answer both, and which one somebody reaches for is a
         matter of where they learned it. -->
    <KeyBinding Gesture="Alt+D"          Command="{Binding ActiveTab.BeginEditPathCommand}"/>
    <!-- KDE's standard "Configure" gesture, so it is where a Plasma user reaches. -->
    <KeyBinding Gesture="Ctrl+Shift+OemComma" Command="{Binding OpenSettingsCommand}"/>
  </Window.KeyBindings>

  <Grid>

  <DockPanel>



    <!-- Free space is gone from here: it is one number about one drive, and the
         drive row in the sidebar now prints it beside the drive it describes.
         Printing it in both places meant the window stated the same fact twice
         and, in split view, disagreed with itself when the two sides were on
         different drives. -->
    <Border DockPanel.Dock="Bottom" Height="26" Padding="12,0"
            Background="{DynamicResource ChromeBrush}"
            IsVisible="{Binding ShowStatusBar}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorColour}">
      <!-- Status, a dot, then the summary — the order and the separator the
           design draws. Both dim: with free space gone there is no longer a
           primary reading here to set one of them above the other, and one
           bright item next to one faint one made the bar look unfinished. -->
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <!-- The count leads, as the design draws it. ActiveStatus is usually
             empty — it carries transient messages — so the separator is bound
             to IT rather than to the count: gated the other way round, an empty
             status left a dot floating at the start of the bar with nothing in
             front of it. -->
        <TextBlock Text="{Binding ActiveSummary}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource ViewDimText}"/>
        <TextBlock Text="·" Opacity="0.55"
                   IsVisible="{Binding ActiveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource ViewDimText}"/>
        <TextBlock Text="{Binding ActiveStatus}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource ViewDimText}"/>
      </StackPanel>
    </Border>

    <!-- **Not bound to ActiveOperation.** It was, and every failure message
         was therefore written and hidden in the same instant: the completion
         handler sets "failed: …" or names the files left behind, then clears
         ActiveOperation because nothing is running any more, and the bar went
         with it. Nobody ever learned which file did not arrive.

         ShowOperationBar is "something is running OR there is something to
         say"; the pause and cancel buttons still follow the operation, because
         there is nothing to pause once it has finished. -->
    <Border DockPanel.Dock="Bottom" Padding="8,5" Background="{DynamicResource AppBackground}"
            IsVisible="{Binding ShowOperationBar}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding OperationStatus}" FontFamily="monospace"
                   FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <!-- Pause was implemented in full and unreachable: the handle has a
             real gate and both engines wait on it between items and inside the
             byte loop, so stopping a large copy mid-flight has always worked
             and nothing could ask for it. -->
        <Button Content="{Binding PauseLabel}" FontSize="{DynamicResource FontSizeSmall}" Padding="8,2"
                IsVisible="{Binding ActiveOperation, Converter={x:Static ObjectConverters.IsNotNull}}"
                Command="{Binding PauseOperationCommand}"/>
        <Button Content="cancel" FontSize="{DynamicResource FontSizeSmall}" Padding="8,2"
                IsVisible="{Binding ActiveOperation, Converter={x:Static ObjectConverters.IsNotNull}}"
                Command="{Binding CancelOperationCommand}"/>
        <!-- The bar now outlives the operation, so the message needs a way to
             go away that is not "wait for the next copy". -->
        <Button Content="dismiss" FontSize="{DynamicResource FontSizeSmall}" Padding="8,2"
                IsVisible="{Binding OperationFinished}"
                Command="{Binding DismissOperationStatusCommand}"/>
      </StackPanel>
    </Border>

    <!-- Inline bar rather than a modal dialog: when you are about to destroy
         something you want the listing still visible behind the question. -->
    <Border x:Name="PromptBar" DockPanel.Dock="Bottom" Padding="8,6"
            Background="{DynamicResource AppBackground}" IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="PromptLabel" FontSize="{DynamicResource FontSizeBase}" VerticalAlignment="Center"/>
        <TextBox x:Name="PromptInput" Width="320" FontFamily="monospace"
                 FontSize="{DynamicResource FontSizeBase}" IsVisible="False"/>
        <!-- Real buttons, not just a keystroke. A destructive confirmation
             needs a clickable affordance, and a focused Button answers Enter
             through the control system rather than through a hand-rolled key
             handler that can be intercepted anywhere along the route. -->
        <Button x:Name="PromptConfirm" IsVisible="False" Padding="12,3"
                FontSize="{DynamicResource FontSizeSmall}"/>
        <Button x:Name="PromptCancel" Content="cancel" IsVisible="False" Padding="12,3"
                FontSize="{DynamicResource FontSizeSmall}"/>
        <TextBlock x:Name="PromptHint" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.5" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>


    <!-- One wide sidebar with every section present at once. The point of the
         workspace layout is that the things you organise by — places,
         devices — are never behind a panel toggle. -->
    <Border DockPanel.Dock="Left" Background="{DynamicResource PanelBackground}"
            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SeparatorColour}"
            Width="{Binding Sidebar.Width}"
            IsVisible="{Binding Sidebar.IsPanelVisible}">
      <DockPanel>

        <!-- No header. The search box moved to the pane toolbar, next to the
             path it searches under, and the split toggle to the view cluster
             where the other view decisions live — neither had anything to do
             with the list of places underneath them. That reclaims 46px and the
             sidebar now starts at its first group heading. -->

        <ScrollViewer>
          <StackPanel Margin="0,0,0,12">

            <!-- The search results that used to live here are now a popup under
                 the toolbar field. They replaced the places list while a query
                 was live, which meant searching took away the thing you
                 navigate with — and the way back was to clear a field you might
                 still want. The places list no longer changes for any reason. -->

            <StackPanel>

              <ItemsControl ItemsSource="{Binding Sidebar.Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlaceGroupViewModel">
                    <StackPanel Margin="0,14,0,0">
                      <!-- Upper-cased through a converter: Place.Label is data
                           read off the desktop's own places list and must never
                           be rewritten to make a heading look right. The
                           tracking is what separates the heading from its rows,
                           so the group needs no rule above it. -->
                      <TextBlock Text="{Binding Label, Converter={x:Static vm:FileConverters.Upper}}"
                                 Margin="12,0,12,6"
                                 FontSize="{DynamicResource FontSizeTiny}"
                                 FontWeight="Medium"
                                 LetterSpacing="1.1"
                                 Foreground="{DynamicResource ViewDimText}"/>
                      <ItemsControl ItemsSource="{Binding Places}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PlaceItemViewModel">
                          <StackPanel>
                            <!-- Takes a drop, the way the tree and Quick access
                                 do in Explorer. Dragging a file onto Downloads
                                 or a drive is how a lot of filing gets done,
                                 and the sidebar accepting nothing meant the
                                 drag simply died over it. -->
                            <Button ContextRequested="OnPlaceContextRequested" Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).GoToPlaceCommand}"
                                    CommandParameter="{Binding Path}"
                                    AutomationProperties.Name="{Binding Label}"
                                    ToolTip.Tip="{Binding Path}"
                                    ToolTip.ShowDelay="900"
                                    BorderThickness="0"
                                    DragDrop.AllowDrop="True"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,6" Opacity="{Binding Opacity}">
                              <!-- The wash says both "you are here" and "the drop
                                   lands here", at two strengths of the one accent.
                                   A fill rather than a ring, because a border would
                                   move every row below it as it appeared. -->
                              <Button.Background>
                                <MultiBinding Converter="{x:Static vm:FileConverters.PlaceRowFill}">
                                  <Binding Path="IsCurrent"/>
                                  <Binding Path="IsDropTarget"/>
                                </MultiBinding>
                              </Button.Background>
                              <!-- **Places could be added from two places and
                                   removed from none.** Ctrl+D and the menu both
                                   pinned one; the only way back out was editing
                                   places.json by hand. Only on the rows the user
                                   made — Home, the drives and the shares are not
                                   theirs to remove, and the provider would
                                   ignore the attempt. -->
                              <Button.ContextMenu>
                                <!-- Refused rather than opened empty. Avalonia
                                     pops a ContextMenu whether or not any child
                                     is visible, so gating the only entry gave
                                     every row the user did NOT pin — which on a
                                     fresh install is every row in the sidebar —
                                     a 2px sliver of menu background at the
                                     cursor. Cancelling in Opening is the one
                                     hook that stops the popup itself. -->
                                <ContextMenu Opening="OnPlaceMenuOpening">
                                  <!-- **On every row, which is why the popup is
                                       no longer cancelled for most of them.**
                                       Home, Documents, a drive, a mapped drive
                                       and the bin all used to open nothing at
                                       all; both references offer at least Open
                                       in new tab and Properties on every node
                                       of the navigation pane. -->
                                  <MenuItem Header="Open in new tab"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenPlaceInNewTabCommand}"
                                            CommandParameter="{Binding}"/>
                                  <MenuItem Header="Copy path"
                                            IsVisible="{Binding HasRealPath}"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CopyPlacePathCommand}"
                                            CommandParameter="{Binding}"/>
                                  <!-- Above "Remove from places", and with no
                                       separator between them: Avalonia collapses
                                       none, and the two are mutually exclusive
                                       in practice — a drive is never a row the
                                       user pinned — so a rule would always be
                                       drawn above or below nothing. -->
                                  <MenuItem Header="Eject"
                                            IsVisible="{Binding CanEject}"
                                            IsEnabled="{Binding CanClickEject}"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).EjectPlaceCommand}"
                                            CommandParameter="{Binding}"/>
                                  <!-- **Emptying the bin was reachable only from
                                       inside the bin.** The command was bound in
                                       one place, the band that appears once you
                                       have navigated in — so the gesture both
                                       references offer on the icon itself meant
                                       going there first. -->
                                  <MenuItem Header="{Binding $parent[Window].((vm:ShellViewModel)DataContext).EmptyBinLabel}"
                                            IsVisible="{Binding IsBin}"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).EmptyTrashCommand}"/>
                                  <!-- Only the rows the user made. Home, the
                                       drives and the shares are named by the
                                       system, and a caption on one of those
                                       would vanish at the next reload. -->
                                  <MenuItem Header="Rename…"
                                            IsVisible="{Binding IsUserPinned}"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).RenamePlaceCommand}"
                                            CommandParameter="{Binding}"/>
                                  <MenuItem Header="Remove from places"
                                            IsVisible="{Binding IsUserPinned}"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).RemovePlaceCommand}"
                                            CommandParameter="{Binding}"/>
                                  <Separator IsVisible="{Binding HasRealPath}"/>
                                  <!-- No InputGesture. Alt+Enter opens properties
                                       for the LISTING's selection, not for the
                                       sidebar row under the pointer — and a
                                       printed shortcut that does something else
                                       is worse than none. -->
                                  <MenuItem Header="Properties"
                                            IsVisible="{Binding HasRealPath}"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowPlacePropertiesCommand}"
                                            CommandParameter="{Binding}"/>
                                </ContextMenu>
                              </Button.ContextMenu>
                              <StackPanel>
                                <!-- ONE line: bar, icon, label, free space. The
                                     drive row used to be three lines tall, which
                                     is why the icon had to bottom-align inside
                                     its own line — a centred icon floated
                                     halfway down the row, level with nothing.
                                     At one line the whole row centres and that
                                     workaround goes.
                                     The accent bar alone is a 2x14px mark at
                                     this height, so the current row also takes a
                                     wash of the accent as its background. -->
                                <DockPanel>
                                  <Border DockPanel.Dock="Left" Width="2" Margin="0,1,8,1"
                                        Background="{DynamicResource AccentColour}"
                                        IsVisible="{Binding IsCurrent}"/>
                                  <Path DockPanel.Dock="Left" Margin="0,0,10,0"
                                        Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Stroke="{DynamicResource ViewText}"
                                        StrokeThickness="{DynamicResource IconStroke}"
                                        StrokeLineCap="Round" StrokeJoin="Round"
                                        th:SidebarIcon.Token="{Binding Icon}"/>
                                  <!-- **Declared first among the right-docked
                                       children, so it takes the far edge** —
                                       the order the sharing rows already prove,
                                       where the ✕ is declared before the copy
                                       button and lands rightmost.

                                       Always drawn, never revealed on hover:
                                       there is not one hover-gated control in
                                       this window, and a hover gate is either
                                       out of the tab order or an invisible
                                       focus target. CanEject is true only for
                                       removable drives, so on an ordinary
                                       machine this adds a button to no rows at
                                       all. -->
                                  <Button DockPanel.Dock="Right" Padding="4,0" Margin="6,0,0,0"
                                          Background="Transparent" BorderThickness="0"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding CanEject}"
                                          IsEnabled="{Binding CanClickEject}"
                                          AutomationProperties.Name="{Binding EjectHint}"
                                          ToolTip.Tip="{Binding EjectHint}"
                                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).EjectPlaceCommand}"
                                          CommandParameter="{Binding}">
                                    <!-- Drawn rather than typed: U+23CF is not
                                         in the UI font and renders as tofu. -->
                                    <Path Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          Stroke="{DynamicResource ViewText}"
                                          StrokeThickness="{DynamicResource IconStroke}"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M6 10.5 L12 5 L18 10.5 Z M6 15 H18"/>
                                  </Button>
                                  <!-- In the free-space slot rather than the
                                       label: with two sticks plugged in, a row
                                       that stops saying which drive it is is a
                                       row nobody can check. "offline" already
                                       reports a dead mount the same way. -->
                                  <TextBlock DockPanel.Dock="Right" Text="ejecting…"
                                             VerticalAlignment="Center" Margin="8,0,0,0"
                                             FontSize="{DynamicResource FontSizeTiny}"
                                             Foreground="{DynamicResource ViewDimText}"
                                             IsVisible="{Binding IsEjecting}"/>
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding CapacityShort}"
                                             VerticalAlignment="Center" Margin="8,0,0,0"
                                             FontSize="{DynamicResource FontSizeTiny}"
                                             Foreground="{DynamicResource ViewDimText}"
                                             IsVisible="{Binding ShowCapacity}"
                                             ToolTip.Tip="{Binding CapacityText}"/>
                                  <TextBlock Text="{Binding Label}"
                                             VerticalAlignment="Center"
                                             FontSize="{DynamicResource FontSizeBase}"
                                             TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ProgressBar Value="{Binding UsedFraction}" Maximum="1"
                                             Height="2" Margin="10,6,0,0"
                                             IsVisible="{Binding ShowCapacity}"/>
                              </StackPanel>
                            </Button>

                            <!-- **This PC, directly under Home.** The sidebar
                                 lists the drives individually, which is not the
                                 same thing as somewhere you can open, sort,
                                 select in or put in a tab — and it is where a
                                 drive root goes when you press Up. Fixed rather
                                 than a group, like Recent: it exists whether or
                                 not anything is attached.

                                 Drawn from inside the Home row's own template,
                                 because a DataTemplate cannot ask where it sits
                                 and only that row knows it leads the sidebar.
                                 Bindings reach out through the Window, since
                                 the DataContext here is the place. -->
                            <Button IsVisible="{Binding LeadsTheSidebar}"
                                    AutomationProperties.Name="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.ComputerLabel}"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.OpenComputerCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,7">
                              <DockPanel>
                                <Border DockPanel.Dock="Left" Width="3" Margin="0,2,6,2" CornerRadius="2"
                                        Background="{DynamicResource AccentColour}"
                                        IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.IsComputerCurrent}"/>
                                <Path DockPanel.Dock="Left" Margin="0,0,9,0"
                                      Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource ViewText}"
                                      StrokeThickness="{DynamicResource IconStroke}"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      th:SidebarIcon.Token="device-desktop"/>
                                <TextBlock Text="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Sidebar.ComputerLabel}"
                                           FontSize="{DynamicResource FontSizeBase}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                              </DockPanel>
                            </Button>
                          </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Network, sharing and frequent folders. -->
              <StackPanel Margin="0,14,0,0">
                <!-- Servers announcing themselves on the LAN. copyparty does
                     this when started with -z, which is how Vaktari starts its own
                     shares — so two machines running Vaktari find each other with
                     no configuration, and so does any NAS on the network. -->
                <StackPanel Margin="0,8,0,12">
                  <DockPanel Margin="12,0,8,2">
                    <!-- Both directions of "network" in one header: what is
                         out there, and what this machine offers. -->
                    <Button DockPanel.Dock="Right" Content="scan" Padding="4,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="{DynamicResource FontSizeTiny}"
                            AutomationProperties.Name="look for servers on the network" ToolTip.Tip="look for servers on the network"
                            IsEnabled="{Binding CanBrowseNetwork}"
                            Command="{Binding BrowseNetworkCommand}"/>
                    <Button DockPanel.Dock="Right" Content="share" Padding="4,0" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="{DynamicResource FontSizeTiny}"
                            AutomationProperties.Name="share a folder from this machine" ToolTip.Tip="share a folder from this machine"
                            IsVisible="{Binding CanShare}"
                            Command="{Binding RequestShareCommand}"/>
                    <!-- Written upper-case rather than run through the Upper
                         converter: this is a literal, and the converter exists
                         for Place.Label, which is data. -->
                    <TextBlock Text="NETWORK" FontSize="{DynamicResource FontSizeTiny}"
                               FontWeight="Medium" LetterSpacing="1.1"
                               Foreground="{DynamicResource ViewDimText}"/>
                  </DockPanel>

                  <ItemsControl ItemsSource="{Binding Discovered}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pl:DiscoveredService">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="12,7"
                                AutomationProperties.Name="{Binding MountUri}" ToolTip.Tip="{Binding MountUri}"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenDiscoveredCommand}"
                                CommandParameter="{Binding}">
                          <!-- Every Style inside a ContextMenu needs its own
                               x:DataType, or setters resolve against the window
                               type and bind to nothing. -->
                          <Button.ContextMenu>
                            <ContextMenu x:DataType="pl:DiscoveredService">
                              <MenuItem Header="Connect"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenDiscoveredCommand}"
                                        CommandParameter="{Binding}"/>
                              <Separator/>
                              <MenuItem Header="Properties"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowServiceInfoCommand}"
                                        CommandParameter="{Binding}"/>
                            </ContextMenu>
                          </Button.ContextMenu>
                          <DockPanel>
                            <Path DockPanel.Dock="Left" Margin="0,0,9,0"
                                  Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource ViewText}"
                                  StrokeThickness="{DynamicResource IconStroke}"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  th:SidebarIcon.Token="server"/>
                          <!-- Docked, not stacked, for the reason given on the
                               REMOTE rows: a horizontal StackPanel measures its
                               children with infinite width, so the trimming
                               below never engages and a long advertised name
                               pushes the protocol tag off the edge instead.
                               An mDNS instance name is not chosen for brevity —
                               "Flint-PC-c-webdav" is what copyparty announces. -->
                          <TextBlock Text="{Binding Friendly}" DockPanel.Dock="Right"
                                     Margin="6,0,0,0"
                                     FontSize="{DynamicResource FontSizeTiny}"
                                     Foreground="{DynamicResource ViewDimText}"
                                     VerticalAlignment="Center"/>

                          <TextBlock Text="{Binding Name}"
                                     FontSize="{DynamicResource FontSizeBase}"
                                     TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Remote mounts. Whatever the desktop has connected shows up
                     here as an ordinary path, so every protocol KIO or gvfs
                     supports works without Vaktari knowing any of them. -->
                <StackPanel IsVisible="{Binding Sidebar.HasRemotes}" Margin="0,8,0,12">
                  <DockPanel Margin="12,0,8,2">
                    <Button DockPanel.Dock="Right" Content="+" Padding="4,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="{DynamicResource FontSizeTiny}"
                            AutomationProperties.Name="connect to a server…" ToolTip.Tip="connect to a server…"
                            IsEnabled="{Binding CanConnect}"
                            Command="{Binding ConnectCommand}"/>
                    <TextBlock Text="REMOTE" FontSize="{DynamicResource FontSizeTiny}"
                               FontWeight="Medium" LetterSpacing="1.1"
                               Foreground="{DynamicResource ViewDimText}"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Sidebar.Remotes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pl:RemoteMount">
                        <!-- Name and tooltip on the row, not on the label: the
                             label is deliberately allowed to be shorter than
                             the truth, and a tooltip on the TextBlock only
                             fires over the text — never over the icon, the
                             "offline" tag or the padded remainder of the row.
                             The discovered-service row above already does it
                             this way, and the row had no accessible name at
                             all. -->
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="12,7"
                                AutomationProperties.Name="{Binding Path}" ToolTip.Tip="{Binding Path}"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).GoToPlaceCommand}"
                                CommandParameter="{Binding Path}">
                          <Button.ContextMenu>
                            <ContextMenu x:DataType="pl:RemoteMount">
                              <MenuItem Header="Open"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).GoToPlaceCommand}"
                                        CommandParameter="{Binding Path}"/>
                              <MenuItem Header="Copy local path"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CopyRemotePathCommand}"
                                        CommandParameter="{Binding}"/>
                              <!-- A rule was here too. Four entries carved into
                                   three sections is more rules than menu, and it
                                   made Disconnect read as its own category; this
                                   is now actions, one rule, Properties — the
                                   shape the discovered-service menu above uses. -->
                              <MenuItem Header="Disconnect"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).DisconnectRemoteCommand}"
                                        CommandParameter="{Binding}"/>
                              <Separator/>
                              <MenuItem Header="Properties"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowRemoteInfoCommand}"
                                        CommandParameter="{Binding}"/>
                            </ContextMenu>
                          </Button.ContextMenu>
                          <DockPanel>
                            <Path DockPanel.Dock="Left" Margin="0,0,9,0"
                                  Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource ViewText}"
                                  StrokeThickness="{DynamicResource IconStroke}"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  th:SidebarIcon.Token="server"/>
                          <!-- **A DockPanel, not a horizontal StackPanel.** The
                               label already asked for CharacterEllipsis and
                               never got it: a horizontal StackPanel measures
                               its children with infinite width, so a TextBlock
                               inside one is never told it has run out of room
                               and trimming cannot engage. A network label is
                               the longest thing the sidebar ever shows —
                               "files on 192.168.4.39:8080" — so it simply ran
                               off the edge, cut mid-character with no ellipsis
                               to say it had.

                               Docking "offline" right and letting the label
                               take what remains gives it a real width, which is
                               all trimming ever needed. -->
                          <TextBlock Text="offline" DockPanel.Dock="Right"
                                     IsVisible="{Binding !Reachable}"
                                     Margin="6,0,0,0"
                                     FontSize="{DynamicResource FontSizeTiny}"
                                     Foreground="{DynamicResource AccentText}"
                                     VerticalAlignment="Center"/>

                          <TextBlock Text="{Binding Label}"
                                     FontSize="{DynamicResource FontSizeBase}"
                                     TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Connect stays reachable even with nothing mounted yet. The
                     same command as the "+" beside REMOTE, so it carries the
                     same name, the same tooltip and the same gate — the two
                     used to disagree on both the wording and whether they
                     could be clicked. -->
                <Button IsVisible="{Binding !Sidebar.HasRemotes}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="12,7"
                        Margin="0,8,0,12"
                        FontSize="{DynamicResource FontSizeBase}"
                        AutomationProperties.Name="connect to a server…" ToolTip.Tip="connect to a server…"
                        IsEnabled="{Binding CanConnect}"
                        Command="{Binding ConnectCommand}">
                  <DockPanel>
                    <Path DockPanel.Dock="Left" Margin="0,0,9,0"
                          Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource ViewText}"
                          StrokeThickness="{DynamicResource IconStroke}"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          th:SidebarIcon.Token="server"/>
                    <TextBlock Text="connect to a server…"
                               FontSize="{DynamicResource FontSizeBase}"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                </Button>

                <!-- Active shares. Deliberately always visible while running:
                     a folder open to the network must never be something you
                     have to remember. -->
                <StackPanel IsVisible="{Binding HasAnySharing}" Margin="0,8,0,12">
                  <TextBlock Text="SHARING" Margin="12,0,12,6"
                             FontSize="{DynamicResource FontSizeTiny}"
                             FontWeight="Medium" LetterSpacing="1.1"
                             Foreground="{DynamicResource ViewDimText}"/>
                  <ItemsControl ItemsSource="{Binding Shares}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="sh:ShareSession">
                        <Border Margin="8,2" Padding="6,4" CornerRadius="4"
                                Background="{DynamicResource HoverBackground}">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="4,0"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="{DynamicResource FontSizeTiny}"
                                    AutomationProperties.Name="stop sharing" ToolTip.Tip="stop sharing"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).StopShareCommand}"
                                    CommandParameter="{Binding}"/>
                            <Button DockPanel.Dock="Right" Content="copy" Padding="6,0"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="{DynamicResource FontSizeTiny}"
                                    AutomationProperties.Name="copy the address" ToolTip.Tip="copy the address"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CopyShareUrlCommand}"
                                    CommandParameter="{Binding}"/>
                            <StackPanel>
                              <TextBlock Text="{Binding Label}"
                                         FontSize="{DynamicResource FontSizeBase}"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Url}"
                                         FontSize="{DynamicResource FontSizeTiny}"
                                         Foreground="{DynamicResource ViewDimText}"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Proton links, under the served folders. Same row, same
                       kill switch — a link that outlives the app is MORE worth
                       keeping in sight than a server that dies with it. -->
                  <ItemsControl ItemsSource="{Binding DriveLinks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="sh:DriveLink">
                        <Border Margin="8,2" Padding="6,4" CornerRadius="4"
                                Background="{DynamicResource HoverBackground}">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="4,0"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="{DynamicResource FontSizeTiny}"
                                    AutomationProperties.Name="stop sharing this link" ToolTip.Tip="stop sharing this link"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).StopDriveLinkCommand}"
                                    CommandParameter="{Binding}"/>
                            <Button DockPanel.Dock="Right" Content="copy" Padding="6,0"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="{DynamicResource FontSizeTiny}"
                                    AutomationProperties.Name="copy the link" ToolTip.Tip="copy the link"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CopyDriveLinkCommand}"
                                    CommandParameter="{Binding}"/>
                            <StackPanel>
                              <TextBlock Text="{Binding Label}"
                                         FontSize="{DynamicResource FontSizeBase}"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Url}"
                                         FontSize="{DynamicResource FontSizeTiny}"
                                         Foreground="{DynamicResource ViewDimText}"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Recent. Ordered to match Dolphin, where Recent sits between
                     the remote entries and Devices. Always shown: these two are
                     places that exist whether or not they currently hold
                     anything. -->
                <StackPanel Margin="0,14,0,0">
                  <TextBlock Text="RECENT" Margin="12,0,12,6"
                             FontSize="{DynamicResource FontSizeTiny}"
                             FontWeight="Medium" LetterSpacing="1.1"
                             Foreground="{DynamicResource ViewDimText}"/>
                  <Button Command="{Binding Sidebar.OpenRecentFilesCommand}"
                          Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="12,7">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="3" Margin="0,2,6,2" CornerRadius="2"
                              Background="{DynamicResource AccentColour}"
                              IsVisible="{Binding Sidebar.IsRecentFilesCurrent}"/>
                      <Path DockPanel.Dock="Left" Margin="0,0,9,0"
                            Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource ViewText}"
                            StrokeThickness="{DynamicResource IconStroke}"
                            StrokeLineCap="Round" StrokeJoin="Round"
                            th:SidebarIcon.Token="recent-files"/>
                      <TextBlock Text="Recent files"
                                 FontSize="{DynamicResource FontSizeBase}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                    </DockPanel>
                  </Button>
                  <Button Command="{Binding Sidebar.OpenRecentLocationsCommand}"
                          Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="12,7">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="3" Margin="0,2,6,2" CornerRadius="2"
                              Background="{DynamicResource AccentColour}"
                              IsVisible="{Binding Sidebar.IsRecentLocationsCurrent}"/>
                      <Path DockPanel.Dock="Left" Margin="0,0,9,0"
                            Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource ViewText}"
                            StrokeThickness="{DynamicResource IconStroke}"
                            StrokeLineCap="Round" StrokeJoin="Round"
                            th:SidebarIcon.Token="recent-locations"/>
                      <TextBlock Text="Recent locations"
                                 FontSize="{DynamicResource FontSizeBase}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                    </DockPanel>
                  </Button>
                </StackPanel>


              </StackPanel>

            </StackPanel>
          </StackPanel>
        </ScrollViewer>


      </DockPanel>
    </Border>

    <!-- **The sidebar had no resize handle at all.** Its width was bound here,
         saved into the session and restored from it, so everything around the
         value worked — but nothing could ever change it. It sat on whatever
         was written last, or the 210 default, and read as a locked panel
         because it was one.

         A Thumb rather than a GridSplitter, and that is forced: a splitter
         resizes by editing the Row or ColumnDefinitions it sits between, and
         the sidebar lives in a DockPanel, which has neither. The window's one
         GridSplitter, the split handle below, is inside a Grid. The details
         panel had a second one that was not, which is why that panel now has
         no handle at all.

         Transparent, because the sidebar's own 1px right border is already the
         separator; this is grab area, and the cursor announces it. The default
         Thumb template draws a themed rectangle, so it is replaced with a bare
         Border or the handle would be a visible slab. -->
    <Thumb x:Name="SidebarHandle" DockPanel.Dock="Left"
           Width="5" Background="Transparent" Cursor="SizeWestEast"
           IsVisible="{Binding Sidebar.IsPanelVisible}">
      <Thumb.Template>
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>

    <Grid x:Name="SplitGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LeftColumnWidth}"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="{Binding RightColumnWidth}"/>
      </Grid.ColumnDefinitions>

      <ContentControl Grid.Column="0" Content="{Binding Left}"
                      ContentTemplate="{StaticResource PaneGroupTemplate}"/>

      <GridSplitter x:Name="SplitHandle" Grid.Column="1" Width="4"
                    Background="{DynamicResource BorderColour}" ResizeDirection="Columns"
                    IsVisible="{Binding IsSplit}"/>

      <ContentControl Grid.Column="2" Content="{Binding Right}"
                      ContentTemplate="{StaticResource PaneGroupTemplate}"
                      IsVisible="{Binding IsSplit}"/>
    </Grid>

  </DockPanel>

    <!-- Rubber-band selection. A single overlay for the whole window rather than
         one per pane: only one band can be dragged at a time, and a window-level
         layer needs no coordinate translation between split sides.
         IsHitTestVisible=False so the band never swallows the drag that draws it. -->
    <Canvas x:Name="BandLayer" IsHitTestVisible="False">
      <Border x:Name="SelectionBand" IsVisible="False"
              Background="{DynamicResource AccentDim}"
              BorderBrush="{DynamicResource AccentColour}"
              BorderThickness="1" CornerRadius="1" Opacity="0.45"/>
    </Canvas>

  </Grid>

</Window>
