<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Vaktari.Core;assembly=Vaktari.Core"
        xmlns:vm="clr-namespace:Vaktari.Ui.ViewModels"
        x:Class="Vaktari.Ui.BatchRenameWindow"
        x:DataType="vm:BatchRenameViewModel"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource ViewText}"
        FontFamily="{DynamicResource AppFontFamily}"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="10">

      <UniformGrid Columns="2">
        <RadioButton Content="Numbered" GroupName="mode"
                     FontSize="{DynamicResource FontSizeSmall}"
                     IsChecked="{Binding IsNumbered}"/>
        <RadioButton Content="Find and replace" GroupName="mode"
                     FontSize="{DynamicResource FontSizeSmall}"
                     IsChecked="{Binding !IsNumbered}"/>
      </UniformGrid>

      <StackPanel Spacing="8" IsVisible="{Binding IsNumbered}">
        <TextBlock Text="Pattern — each run of # becomes the counter, zero padded"
                   FontSize="{DynamicResource FontSizeTiny}"
                   Foreground="{DynamicResource ViewDimText}"/>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                      Margin="10,0,0,0">
            <TextBlock Text="Start at" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource ViewDimText}"/>
            <NumericUpDown Value="{Binding StartAt}" Minimum="0" Maximum="99999"
                           Width="110" FontSize="{DynamicResource FontSizeSmall}"/>
          </StackPanel>
          <TextBox Text="{Binding Pattern}" FontFamily="{DynamicResource AppMonoFamily}"
                   FontSize="{DynamicResource FontSizeSmall}"/>
        </DockPanel>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding !IsNumbered}">
        <TextBox Text="{Binding Find}" PlaceholderText="Find"
                 FontFamily="{DynamicResource AppMonoFamily}" FontSize="{DynamicResource FontSizeSmall}"/>
        <TextBox Text="{Binding Replace}" PlaceholderText="Replace with"
                 FontFamily="{DynamicResource AppMonoFamily}" FontSize="{DynamicResource FontSizeSmall}"/>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <CheckBox Content="Regular expression" IsChecked="{Binding UseRegex}"
                    FontSize="{DynamicResource FontSizeSmall}"/>
          <CheckBox Content="Match case" IsChecked="{Binding CaseSensitive}"
                    FontSize="{DynamicResource FontSizeSmall}"/>
        </StackPanel>
      </StackPanel>

      <CheckBox Content="Leave the extension alone" IsChecked="{Binding KeepExtension}"
                FontSize="{DynamicResource FontSizeSmall}"/>

      <Border Height="1" Background="{DynamicResource SeparatorColour}"/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Padding="14,4" IsCancel="True" Command="{Binding CancelCommand}"/>

          <!-- **Enter did nothing, in a dialog whose entire input is a line of
               text.** You type a pattern, read the preview and press Enter,
               and the keystroke went nowhere: Escape got you out, and the only
               way to go ahead was the mouse.

               IsEnabled is load bearing for the keyboard now as well as for
               the pointer, and stays: Avalonia's default button ignores Enter
               while it is disabled, so a plan with a problem in it — or one
               that would rename nothing — cannot be committed by a stray Enter
               any more than it can be clicked. The "Start at" spinner is no
               trap either; it writes StartAt as the digits are typed, so a
               rename started from it uses the number on screen. -->
          <Button Content="Rename" Padding="14,4" IsDefault="True"
                  IsEnabled="{Binding CanApply}" Command="{Binding ApplyCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource ViewDimText}"/>
      </DockPanel>
    </Border>

    <!-- The preview IS the plan: this list is exactly what Rename applies. -->
    <Border Margin="0,12,0,0" BorderThickness="1"
            BorderBrush="{DynamicResource SeparatorColour}"
            Background="{DynamicResource ViewBackground}">
      <ListBox ItemsSource="{Binding Preview}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:RenamePreview">
            <Grid ColumnDefinitions="*,Auto,*" Margin="4,3">
              <TextBlock Grid.Column="0" Text="{Binding OldName}"
                         FontSize="{DynamicResource FontSizeSmall}"
                         FontFamily="{DynamicResource AppMonoFamily}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="  →  " VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource ViewDimText}"/>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding NewName}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontFamily="{DynamicResource AppMonoFamily}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Problems are stated, never silently corrected. -->
                <TextBlock Text="{Binding Problem}"
                           IsVisible="{Binding !IsValid}"
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource AccentText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

  </DockPanel>
</Window>
