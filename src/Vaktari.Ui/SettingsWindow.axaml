<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vaktari.Ui.ViewModels"
        xmlns:fs="clr-namespace:Vaktari.Core.FileSystem;assembly=Vaktari.Core"
        x:Class="Vaktari.Ui.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Vaktari settings"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource ViewText}"
        FontFamily="{DynamicResource AppFontFamily}"
        Width="700" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">

  <!-- **This window had no floor at all, and its chrome is worse off without
       one than the main window's was.** The page list is docked LEFT, has no
       scroller, and its items panel is a WrapPanel — so a short window does not
       clip the list, it WRAPS it into a second and then a third column, and
       every one of those columns is taken out of the width the page had. At
       700x560 the strip is 176px wide; at 700x300 it is 326; at 700x120 it is
       the full 700 with its last column starting past the right edge of the
       window, where that page cannot be reached at all.

       The footer is the one thing that never gives. It is docked Bottom, so the
       DockPanel hands it its 47px first and takes the entire shortfall out of
       the pages: measured from 560px down to 120px it stayed 47 while the
       TabControl went 513, 373, 253, 153, 73.

       520 leaves about 340px of page beside the 176px strip, and each page
       carries 20px margins inside that, so the reading column is the same order
       as the 350px listing the main window's 560 leaves beside its sidebar. 420
       is the shortest window that still holds all six rows in ONE column above
       the footer, with a row of settings beside them. Both numbers are checked
       against the chrome as it actually measures, in WindowFloorTests, rather
       than left to rot when a seventh page is added. -->

  <!-- NO margin on the shell. It used to be 16 all round, which inset the tab
       strip from the window edges so the sidebar colour read as a floating box
       instead of a surface. Spacing now lives INSIDE each region, the way the
       main window does it. -->
  <DockPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource SeparatorColour}"
            BorderThickness="0,1,0,0"
            Padding="16,10">
      <DockPanel>
        <!-- Docked first so the buttons keep their natural width and the
             version takes what is left; a horizontal StackPanel would give the
             text unlimited width and push them off the edge. -->
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Padding="14,4" IsCancel="True" Command="{Binding CancelCommand}"/>

          <!-- **Escape left this window and Enter did not.** Cancel took
               IsCancel when the dialogs learnt Escape, and Save was left
               behind — so the key that throws the page away worked from the
               keyboard while the key that keeps it did nothing at all. Six
               pages of boxes and check boxes, and the only way to commit them
               was to find the mouse.

               Safe from the rest of the page because Avalonia hands its
               default button an UNHANDLED Enter only, and every control on
               these six pages that wants the key takes it first: a focused
               button, a check box, a combo box and a radio button all mark it
               handled and never reach this. What is left is the single-line
               boxes, where Enter has nothing else to mean; the tab headers,
               where it means what it means in any property sheet; the version
               line, which is selectable and so takes focus without wanting the
               key; and a window nobody has tabbed into yet, which has no focus
               at all. Each of those four saves what is already on screen,
               which is what the button says. Counted and pressed on every
               tab, not reasoned about. -->
          <Button Content="Save" Padding="14,4" IsDefault="True" Command="{Binding SaveCommand}"/>
        </StackPanel>

        <!-- **Nothing in this dialog could say where the choices go.** The
             version line beside this shows a path on hover and it is the path
             of the BINARY; settings.json could only be found by knowing where
             the platform keeps config, or by searching for it. Which also
             meant there was no way to keep a copy of a set-up, or to put one
             back on another machine.

             In the footer with the version rather than on a page, because it
             is about the file rather than about anything in it — the same kind
             of thing as the build number it sits next to.

             One button with a menu rather than three buttons: three would push
             the version line off a narrow window, and these are rare actions
             next to Save and Cancel, which are not. -->
        <Button DockPanel.Dock="Left"
                Content="Settings file"
                Padding="10,4"
                Margin="0,0,12,0"
                IsEnabled="{Binding HasSettingsFile}"
                ToolTip.Tip="{Binding SettingsFile}">
          <Button.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedLeft">
              <MenuItem Header="_Show settings file"
                        Command="{Binding ShowSettingsFileCommand}"/>
              <MenuItem Header="Save a _copy…"
                        Command="{Binding ExportSettingsCommand}"/>
              <MenuItem Header="_Replace from a copy…"
                        Command="{Binding ImportSettingsCommand}"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- **There was no way back to the defaults.** Nine sections on the
             General page and five more pages, each remembering what it was
             last set to, and the only route out was to close Vaktari, find
             settings.json, delete it and start again.

             Beside the settings-file button rather than next to Save, because
             both are about the settings AS A WHOLE rather than about any one
             of them — and because a destructive-looking button next to the
             one that commits is the wrong pair to put a thumb between. -->
        <Button DockPanel.Dock="Left"
                Content="Restore defaults"
                Padding="10,4"
                Margin="0,0,12,0"
                Command="{Binding RestoreDefaultsCommand}"/>

        <!-- Takes the space the version line would have had, and only when
             there is something to say. A refusal — a file this version cannot
             read — has to be readable somewhere, and none of these three is
             worth a dialog of its own. -->
        <SelectableTextBlock DockPanel.Dock="Left"
                             Text="{Binding SettingsFileStatus}"
                             IsVisible="{Binding SettingsFileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             FontSize="{DynamicResource FontSizeTiny}"
                             Foreground="{DynamicResource ViewDimText}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"
                             TextTrimming="CharacterEllipsis"/>

        <!-- **The version line was the whole of the About box, and a dead
             end.** A number, and on hover the path of the binary — nothing
             saying what changed in that version, nothing naming the project,
             and no way to reach either without knowing where to look.

             A flyout on the number itself rather than a seventh page: the
             page strip is a WrapPanel with no scroller, so a seventh row is
             taken out of the width every page has (see the floor note at the
             top of this file), and this is three lines of content. -->
        <Button Content="{Binding VersionLine}"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                FontSize="{DynamicResource FontSizeTiny}"
                Foreground="{DynamicResource ViewDimText}"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">
          <Button.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedLeft">
              <MenuItem Header="_What is new in this version"
                        Command="{Binding OpenReleasesCommand}"/>
              <MenuItem Header="_The project"
                        Command="{Binding OpenProjectCommand}"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Selectable, because the reason anyone reads a version is to quote
             it somewhere — an issue, a message. A number you can see and not
             copy makes them type it out and get it wrong. Kept beside the
             button rather than replaced by it: a button label cannot be
             selected, and quoting the build is what this line is for. -->
        <SelectableTextBlock Text="{Binding InstalledAt}"
                             ToolTip.Tip="{Binding VersionPath}"
                             FontSize="{DynamicResource FontSizeTiny}"
                             Foreground="{DynamicResource ViewDimText}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <!-- The strip runs down the LEFT.
         Across the top it wrapped onto three ragged lines once all six pages
         existed, because the header text is wider than the dialog. A vertical
         list cannot wrap, reads as a list of places rather than a row of
         controls, and matches the main window's own left-hand sidebar. -->
    <!-- PanelBackground is the same brush the main window's sidebar uses, so
         the strip reads as the same kind of surface. Set on the TabControl
         rather than on the strip's internal presenter, which would mean
         reaching into the Fluent template; the page content below paints
         AppBackground back over the right-hand side. -->
    <TabControl TabStripPlacement="Left" Padding="0"
                Background="{DynamicResource PanelBackground}">

      <TabControl.Styles>
        <!-- Styled to match the sidebar: transparent, left-aligned, dim until
             chosen. The Fluent default draws a heavy pill that fights the rest
             of the application. -->
        <!-- OUR OWN TEMPLATE, not Fluent's.
             Removing the selected fill and then the SemiBold weight both failed
             to stop the label shifting as pages were clicked, and Fluent's
             TabItem template cannot be inspected from here — so rather than
             guess at it a third time, this replaces it with one where nothing
             state-dependent touches layout.

             The accent bar is OVERLAID in a Panel, exactly as the main window
             draws a selected row's edge bar: showing and hiding it moves
             nothing, because it never occupied space. The ContentPresenter's
             margin is identical in every state. Only Foreground changes. -->
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
          <Setter Property="Foreground" Value="{DynamicResource ViewDimText}"/>
          <Setter Property="MinWidth" Value="150"/>
          <Setter Property="Template">
            <ControlTemplate>
              <Panel Background="Transparent">
                <Border Name="Accent" Width="3" HorizontalAlignment="Left"
                        Margin="0,5" CornerRadius="2"
                        Background="{DynamicResource AccentColour}"
                        IsVisible="False"/>
                <ContentPresenter Content="{TemplateBinding Header}"
                                  RecognizesAccessKey="False"
                                  Margin="16,7"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
              </Panel>
            </ControlTemplate>
          </Setter>
        </Style>

        <Style Selector="TabItem:selected">
          <Setter Property="Foreground" Value="{DynamicResource ViewText}"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#Accent">
          <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="TabItem:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource ViewText}"/>
        </Style>

      </TabControl.Styles>

      <!-- General comes first, as it does in Dolphin. Its Previews and
           Confirmations tabs are not here yet: they arrive with the plumbing
           that makes them do something. -->
      <TabItem Header="General">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Sorting"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding NaturalSorting}">
              <StackPanel>
                <TextBlock Text="Natural sorting"/>
                <TextBlock Text="file2 before file10, rather than file1, file10, file2."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>

            <CheckBox Content="Case sensitive"
                      Margin="24,0,0,0"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsEnabled="{Binding CanSetCaseSensitivity}"
                      IsChecked="{Binding CaseSensitiveSorting}"/>

            <!-- Beside the other two sorting rules, because that is what it
                 is: the comparer applied it ahead of the field and read no
                 setting, so sorting by modified could not put a folder at the
                 top however recently it changed. Ticked out of the box, which
                 is both the shipped behaviour and what all three references
                 do. -->
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding FoldersFirst}">
              <StackPanel>
                <TextBlock Text="Sort folders before files"/>
                <TextBlock Text="On, folders are banded above the files whichever column you sort by. Off, they take their place in the order like anything else — the newest thing in a folder can then be a folder. Grouping by size or by type keeps a Folders band whichever way this is set, because those bands have a heading; grouping by name or by date does not, and there this decides whether folders lead inside each band."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Behaviour"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding RememberViewPerFolder}">
              <StackPanel>
                <TextBlock Text="Remember the view for each folder"/>
                <TextBlock Text="Off, every folder uses the same view. On, a folder keeps the layout, sort and grouping you last gave it. Stored centrally rather than written into your folders, but a view another file manager has already written into a folder is still honoured."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>

            <!-- **Turning the box above off left every folder already recorded
                 exactly as it was.** The store fills up on its own — merely
                 LOOKING at a folder writes to it — and there was no way to see
                 it or empty it from anywhere in the application.

                 Indented under the box it belongs to, and shown only when
                 there is something to forget: an offer to clear an empty list
                 is a button that does nothing. -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="24,0,0,0"
                        IsVisible="{Binding HasRememberedViews}">
              <Button Content="Forget remembered views"
                      Padding="10,3"
                      FontSize="{DynamicResource FontSizeSmall}"
                      Command="{Binding ForgetRememberedViewsCommand}"/>
              <TextBlock Text="{Binding RememberedViewsLabel}"
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         VerticalAlignment="Center"/>
            </StackPanel>

            <!-- **Every folder and every file opened was recorded, with no
                 setting consulted and no way to empty the list** — the only
                 route out was a per-row "Forget", which needs the entry still
                 on screen and there is one row per entry.

                 On by default: both references record by default, and a
                 privacy switch that ships off is a feature nobody finds. -->
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding RememberRecent}">
              <StackPanel>
                <TextBlock Text="Remember recently opened files and folders"/>
                <TextBlock Text="Off, nothing new is recorded. What is already remembered stays until you clear it."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>

            <!-- Separate from the switch above, and only when there is
                 something to clear: turning recording off must not silently
                 delete a list, because that is not what the checkbox says. -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="24,0,0,0"
                        IsVisible="{Binding HasRecent}">
              <Button Content="Forget what was opened"
                      Padding="10,3"
                      FontSize="{DynamicResource FontSizeSmall}"
                      Command="{Binding ForgetRecentCommand}"/>
              <TextBlock Text="{Binding RecentCountLabel}"
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         VerticalAlignment="Center"/>
            </StackPanel>

            <CheckBox Content="Show tooltips on rows"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowTooltips}"/>

            <CheckBox Content="Tab switches between split panes"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding TabSwitchesSplitPanes}"/>

            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ClosingSplitDiscardsOtherPane}">
              <StackPanel>
                <TextBlock Text="Closing the split discards the other pane"/>
                <TextBlock Text="Off, Vaktari remembers what it was showing so reopening lands back in place."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>

          <!-- **Ninth of nine, under the icon-theme catalogue.** These three
               are the only settings on this page that decide whether a
               keystroke can lose a file, and they sat below a section that is
               a hundred and fifty lines long and grows with every theme
               installed — so on a 560px window the person looking for "stop
               asking me before the bin" scrolled past sorting, splits,
               default-file-manager, a theme catalogue, terminals, Proton Drive,
               the status bar and preview limits to find them.

               Here instead, because these ARE behaviour: the section directly
               above decides what a click does and this decides what a delete
               does. Nothing else moved. -->

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Ask for confirmation before"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="{Binding ConfirmTrashLabel}"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ConfirmMoveToTrash}"/>

            <CheckBox Content="Deleting files permanently"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ConfirmPermanentDelete}"/>

            <CheckBox Content="Closing a window with several tabs open"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ConfirmClosingMultipleTabs}"/>
          </StackPanel>

          <!-- One rule, gated with the section it introduces. There were two
               here — an ungated one and this — so on every platform that can
               answer CanBeDefault, which is both of the ones we ship, the page
               drew a pair of hairlines 14px apart. Keeping the ungated one
               instead would leave a rule hanging under Behaviour with nothing
               below it wherever the section is hidden. -->
          <Border Height="1" Background="{DynamicResource SeparatorColour}"
                  IsVisible="{Binding CanBeDefault}"/>

          <StackPanel Spacing="8" IsVisible="{Binding CanBeDefault}">
            <TextBlock Text="Opening folders"
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"/>

            <!-- A BUTTON, not a checkbox, and that is the honest shape.
                 Everything else on this page edits a copy and commits it when
                 you press Save, which is what makes Cancel mean something. This
                 writes to the system the moment it runs — the registry on
                 Windows, the desktop's file-type database on Linux — and there
                 is no way to stage that. A checkbox would promise the dialog's
                 usual contract and quietly break it. -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Make Vaktari the default"
                      Padding="12,4"
                      IsVisible="{Binding !IsDefaultFileManager}"
                      Command="{Binding MakeDefaultCommand}"
                      FontSize="{DynamicResource FontSizeSmall}"/>
              <Button Content="Stop being the default"
                      Padding="12,4"
                      IsVisible="{Binding IsDefaultFileManager}"
                      Command="{Binding RestoreDefaultCommand}"
                      FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBlock Text="Vaktari opens folders now."
                         IsVisible="{Binding IsDefaultFileManager}"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource ViewDimText}"/>
            </StackPanel>

            <!-- Applies immediately, so it says so where the button is rather
                 than leaving someone to press Save and wonder. -->
            <TextBlock Text="This one takes effect straight away rather than when you press Save."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding DefaultCaveat}"
                       IsVisible="{Binding HasDefaultCaveat}"
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding DefaultStatus}"
                       IsVisible="{Binding HasDefaultStatus}"
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource AccentText}"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Icons"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <!-- **This choice was on screen on Linux, where nothing could act
                 on it, and its explanation named Windows on both platforms.**
                 The setting reaches the listing only through IconLoader.Files,
                 which is IPlatform.FileIcons — Windows has one, freedesktop has
                 none — so on Linux it was a box that remembered being ticked and
                 changed nothing, offering something the desktop's own icon theme
                 was already doing. Hidden where it cannot work, exactly as the
                 default-file-manager section above is; the theme chooser below
                 stays, because that one is live on both. -->
            <StackPanel x:Name="DesktopIconsChoice" Spacing="6"
                        IsVisible="{Binding CanUseDesktopIcons}">
              <CheckBox Content="Use my desktop's icons"
                        FontSize="{DynamicResource FontSizeSmall}"
                        IsChecked="{Binding UseSystemIcons}"/>
              <TextBlock Text="Off, files use the set drawn for Vaktari. On, they use the ones your desktop draws — so a program shows its own icon, a shortcut carries its arrow, and a folder you gave a custom icon keeps it. Thumbnails are unaffected either way."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <!-- An imported theme wins over both, because it is the most
                 deliberate of the three: somebody found a theme, downloaded it
                 and pointed at it. -->
            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Content="Browse…"
                      Margin="6,0,0,0" Padding="10,4"
                      FontSize="{DynamicResource FontSizeSmall}"
                      ToolTip.Tip="A theme folder anywhere on this machine — the one holding index.theme"
                      Command="{Binding BrowseForIconThemeCommand}"/>

              <!-- The themes actually on disk, found rather than remembered, so
                   a fetched pack's variants are one click apart and a folder
                   deleted by hand simply stops being offered. -->
              <ComboBox ItemsSource="{Binding IconThemeChoices}"
                        SelectedItem="{Binding SelectedIconTheme}"
                        HorizontalAlignment="Stretch"
                        FontSize="{DynamicResource FontSizeSmall}"
                        ToolTip.Tip="{Binding IconThemeFolder}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsViewModel+IconThemeChoice">
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>

            <TextBlock Text="{Binding IconThemeProblem}"
                       IsVisible="{Binding HasIconThemeProblem}"
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource AccentText}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Or point at an icon theme you downloaded — the folder holding index.theme. Vaktari reads the freedesktop format, which is what Papirus, Tela, Numix and most Linux icon sets are published as."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>

            <!-- **Or let Vaktari fetch one.** Doing it by hand means finding the
                 project, downloading an archive and extracting it past forty
                 thousand "cannot create symbolic link" errors, because Windows
                 will not make the links a theme is built out of. Unpacked here
                 those links are read rather than made, so there is nothing to
                 get past. -->
            <ItemsControl ItemsSource="{Binding AvailableThemes}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="fs:IconThemeSource">
                  <Border Padding="10,8" Margin="0,0,0,4"
                          CornerRadius="4"
                          Background="{DynamicResource ViewAlternateRow}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Get"
                              Margin="8,0,0,0" Padding="12,4"
                              VerticalAlignment="Center"
                              FontSize="{DynamicResource FontSizeSmall}"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).FetchIconThemeCommand}"
                              CommandParameter="{Binding}"/>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{DynamicResource FontSizeSmall}"/>
                        <TextBlock Text="{Binding Summary}"
                                   FontSize="{DynamicResource FontSizeTiny}"
                                   Foreground="{DynamicResource ViewDimText}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                          <TextBlock FontSize="{DynamicResource FontSizeTiny}"
                                     Foreground="{DynamicResource ViewDimText}"
                                     Text="{Binding Megabytes, StringFormat='About {0} MB'}"/>
                          <TextBlock Text="·"
                                     FontSize="{DynamicResource FontSizeTiny}"
                                     Foreground="{DynamicResource ViewDimText}"/>
                          <TextBlock Text="{Binding Licence}"
                                     FontSize="{DynamicResource FontSizeTiny}"
                                     Foreground="{DynamicResource ViewDimText}"/>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Indeterminate until a fraction means something: a server need
                 not send a length, and the one theme in the catalogue is served
                 chunked with none. A bar at zero reads as a hung download. -->
            <ProgressBar IsVisible="{Binding IsFetchingIconTheme}"
                         IsIndeterminate="{Binding !IconThemeProgressKnown}"
                         Minimum="0" Maximum="1"
                         Height="3"
                         Value="{Binding IconThemeProgress}"/>

            <TextBlock Text="{Binding IconThemeStatus}"
                       IsVisible="{Binding HasIconThemeStatus}"
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource AccentText}"
                       TextWrapping="Wrap"/>

            <!-- An archive from anywhere else goes through the same unpacking,
                 which is the point: a theme downloaded by hand hits the same
                 symbolic-link wall, and this is what gets past it. -->
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
              <Button Content="Install from a file…"
                      Padding="0"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource AccentText}"
                      FontSize="{DynamicResource FontSizeTiny}"
                      Command="{Binding PickIconThemeArchiveCommand}"
                      ToolTip.Tip="A .tar.gz, .tar.xz or .zip you downloaded yourself"/>

              <Button Content="Open the icon folder"
                      Padding="0"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource AccentText}"
                      FontSize="{DynamicResource FontSizeTiny}"
                      Command="{Binding OpenIconFolderCommand}"
                      ToolTip.Tip="Where installed themes are kept"/>

              <Button Content="Find more icon themes"
                      Padding="0"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource AccentText}"
                      FontSize="{DynamicResource FontSizeTiny}"
                      Command="{Binding GetMoreIconsCommand}"
                      ToolTip.Tip="Opens store.kde.org in your browser"/>
            </StackPanel>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Terminal"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <!-- The chooser only earns its place on a machine with more than
                 one, but it is shown regardless: a dropdown reading "Whichever
                 is found first" is how somebody discovers the choice exists at
                 all, and hiding it would make the feature depend on already
                 knowing about it. -->
            <ComboBox ItemsSource="{Binding AvailableTerminals}"
                      SelectedItem="{Binding SelectedTerminal}"
                      HorizontalAlignment="Stretch"
                      FontSize="{DynamicResource FontSizeSmall}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TerminalChoice">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="What F4 and “Open terminal here” open. Only the terminals found on this machine are listed; if you install another one, reopen Vaktari to see it."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Proton Drive"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <TextBox Text="{Binding ProtonDriveFolder}"
                     Watermark="The folder the Proton Drive app syncs, e.g. D:\Proton-Drive"
                     FontSize="{DynamicResource FontSizeSmall}"/>
            <TextBlock Text="With this set — and the Proton Drive CLI installed and signed in — right-clicking anything inside it offers a public share link, and active links appear under SHARING in the sidebar."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Status bar"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Show the status bar"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowStatusBar}"/>

            <!-- No longer indented under the status bar, and no longer disabled
                 with it: the number moved to the sidebar's drive rows, so the
                 two settings are now independent. -->
            <CheckBox Content="Free space on drive rows"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowFreeSpace}"/>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Previews"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Show thumbnails"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowPreviews}"/>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetPreviewLimits}">
              <TextBlock Grid.Column="0" Text="Skip local files larger than (MB)"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding MaxLocalPreviewMegabytes}"
                       PlaceholderText="No limit"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetPreviewLimits}">
              <TextBlock Grid.Column="0" Text="Skip network files larger than (MB)"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding MaxRemotePreviewMegabytes}"
                       PlaceholderText="No limit"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>

            <TextBlock Text="A thumbnail on a mounted share pulls the whole file over the network, which is why the two limits are separate. Blank or 0 means no limit."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap" Margin="24,0,0,0"/>
          </StackPanel>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Startup">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="When Vaktari opens"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <RadioButton GroupName="startup"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding RestoreLastSession}">
              <StackPanel>
                <TextBlock Text="Restore folders, tabs and window from last time"/>
                <TextBlock Text="The default. Forgetting these is the thing this replaces."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </RadioButton>

            <RadioButton Content="Open the home folder" GroupName="startup"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding StartInHome}"/>

            <RadioButton Content="Open a specific folder" GroupName="startup"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding StartInSpecificFolder}"/>
          </StackPanel>

          <!-- **The placeholder said "/home/…" on Windows** — a hardcoded
               Linux path in the one control whose whole job is to be given a
               path on THIS machine. And there was no Browse, so the only way
               to set it was to type a path correctly from memory. -->
          <DockPanel Margin="24,0,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Browse…"
                    Padding="10,3"
                    Margin="8,0,0,0"
                    FontSize="{DynamicResource FontSizeSmall}"
                    IsEnabled="{Binding CanEditStartupFolder}"
                    Command="{Binding BrowseForStartupFolderCommand}"/>

            <TextBox Text="{Binding StartupFolder}"
                     PlaceholderText="{Binding StartupFolderHint}"
                     IsEnabled="{Binding CanEditStartupFolder}"
                     FontSize="{DynamicResource FontSizeSmall}"/>
          </DockPanel>

          <!-- Said, not refused: the folder may be on a stick that is out or a
               share that is down, and refusing to save it would make the
               setting unusable for exactly the people who need it most. -->
          <TextBlock Text="{Binding StartupFolderProblem}"
                     IsVisible="{Binding HasStartupFolderProblem}"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"
                     Margin="24,0,0,0"/>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="How it opens"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Begin in split view"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding BeginInSplitView}"/>

            <CheckBox Content="Show the filter bar"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowFilterBar}"/>

            <!-- "Path bar", because that is what the thing is called everywhere
                 else you meet it — the bar's own tooltip, the README, Ctrl+L.
                 "Location" was doing double duty for this and for Copy location,
                 which is a different thing entirely. The binding stays
                 LocationBarEditable: it is the key this setting is stored under,
                 and renaming it would silently reset the preference on every
                 install that already has one. -->
            <CheckBox Content="Start with the path bar editable"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding LocationBarEditable}"/>

            <CheckBox Content="Show the full path in the title bar"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowFullPathInTitleBar}"/>
          </StackPanel>

          <TextBlock Text="Changes to how it opens apply on the next launch."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="View modes">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Text"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <ComboBox ItemsSource="{Binding AvailableFonts}"
                      SelectedItem="{Binding SelectedFont}"
                      HorizontalAlignment="Stretch"
                      FontSize="{DynamicResource FontSizeSmall}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FontOption">
                  <!-- FIXED width, not Min: every row must measure the same or
                       the popup resizes to whichever items happen to be
                       realized, and it visibly breathes as you scroll. Trimming
                       alone does not do it — a TextBlock still asks for its
                       full desired width unless something constrains it. -->
                  <DockPanel Width="440">
                    <!-- The sample keeps the sentinel row honest: it has no
                         face of its own, so it shows no sample. -->
                    <TextBlock DockPanel.Dock="Right"
                               Text="AaBbGg 0123"
                               IsVisible="{Binding !IsFollowDesktop}"
                               FontFamily="{Binding Family}"
                               Foreground="{DynamicResource ViewDimText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                    <!-- The name now renders in its OWN face, which is what a
                         font picker is expected to do. The trade-off is real
                         and was the reason it did not before: a symbol or icon
                         font draws its own name as glyphs, so that row becomes
                         unreadable. The tooltip carries the plain name for
                         exactly those rows — the list is alphabetical, so
                         position narrows it down and the tooltip settles it. -->
                    <TextBlock Text="{Binding Name}"
                               FontFamily="{Binding Family}"
                               ToolTip.Tip="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="The first entry uses whatever your desktop is set to. This changes the face only; the size is below."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <!-- The rows are decoded by index in InterfaceText.Steps, and a test
               checks this list against it: a row added here and not there would
               store the size of whichever row happened to share its index. -->
          <StackPanel Spacing="6">
            <ComboBox SelectedIndex="{Binding InterfaceTextIndex}"
                      HorizontalAlignment="Stretch"
                      FontSize="{DynamicResource FontSizeSmall}">
              <ComboBoxItem Content="Follow the desktop text size"/>
              <ComboBoxItem Content="100%"/>
              <ComboBoxItem Content="110%"/>
              <ComboBoxItem Content="125%"/>
              <ComboBoxItem Content="150%"/>
              <ComboBoxItem Content="175%"/>
              <ComboBoxItem Content="200%"/>
            </ComboBox>
            <TextBlock Text="How large every label, row, tab and status line is drawn. Following the desktop is the default: on Windows that is the accessibility text size, and on Plasma the general font. Zooming a pane with ctrl and the wheel still works from wherever this leaves it."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <TextBlock Text="Colour"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <ComboBox SelectedIndex="{Binding ThemeModeIndex}"
                      HorizontalAlignment="Stretch"
                      FontSize="{DynamicResource FontSizeSmall}">
              <ComboBoxItem Content="Follow the desktop"/>
              <ComboBoxItem Content="Light"/>
              <ComboBoxItem Content="Dark"/>
            </ComboBox>
            <TextBlock Text="Following the desktop is the default, and the only setting that keeps up when you change your desktop while Vaktari is open. The other two hold whatever you pick."
                       FontSize="{DynamicResource FontSizeTiny}"
                       Foreground="{DynamicResource ViewDimText}"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <!-- The flag behind this has been read on every theme apply for some
               time and had no control at all, so the only way to set it was to
               edit settings.json by hand. -->
          <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                    IsChecked="{Binding FollowDesktopColours}">
            <StackPanel>
              <TextBlock Text="Follow desktop colours"/>
              <TextBlock Text="Off, Vaktari uses its own scheme. On, your desktop's colours and accent are layered over it. This is about hues, not lightness — whichever you choose, the setting above still decides light or dark."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Details panel"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                    IsChecked="{Binding GrowWindowForPanel}">
            <StackPanel>
              <TextBlock Text="Widen the window to fit the details panel"/>
              <TextBlock Text="Off: the toggle is greyed out when the pane is too narrow, and the window keeps the size you gave it. On: the window grows instead — your desktop still caps how far."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>

          <!-- Indented and IsEnabled-bound to the checkbox above, because it does
               nothing on its own: there is no width to hand back unless something
               took some. A dependent option that looks independent invites people
               to tick it and conclude the feature is broken. -->
          <CheckBox Margin="24,0,0,0"
                    FontSize="{DynamicResource FontSizeSmall}"
                    IsEnabled="{Binding GrowWindowForPanel}"
                    IsChecked="{Binding RestoreWidthOnPanelClose}">
            <StackPanel>
              <TextBlock Text="Shrink back when the panel closes"/>
              <TextBlock Text="Returns the window to the width it had before it was widened. Skipped if you have resized the window yourself since — and in split view, only once neither side still needs the room."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Version control"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                    IsChecked="{Binding ShowVcsDecorations}">
            <StackPanel>
              <TextBlock Text="Mark files by version-control status"/>
              <TextBlock Text="M modified · A added · D deleted · ? untracked · ! conflicted. Runs git once per folder, and only inside a repository."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Selection"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <!-- Off by default, which is Explorer's answer rather than Dolphin's:
               the boxes take a slot out of the name column, and a listing that
               grows one uninvited is a worse first impression than a feature
               nobody finds. -->
          <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                    IsChecked="{Binding ShowSelectionBoxes}">
            <StackPanel>
              <TextBlock Text="Show selection check boxes"/>
              <TextBlock Text="A box ahead of every row in all three layouts, and one on the list heading that ticks or clears the lot. The box appears when you point at a row and stays while the row is ticked. Ctrl+click, shift+click and dragging a rectangle round the rows work the same either way."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="File names"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <!-- Here rather than under "List view" below: all three layouts bind
               the same converter, so this is not a property of one of them.
               Ticked out of the box, which is the behaviour the application has
               always had — Explorer ships the same switch unticked, and
               changing what every row says on upgrade is not a default a file
               manager gets to pick for you. -->
          <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                    IsChecked="{Binding ShowFileExtensions}">
            <StackPanel>
              <TextBlock Text="Show file name extensions"/>
              <TextBlock Text="Off, notes.txt lists as notes in all three layouts. Anything that runs when you open it keeps its ending — a program, a script, an installer — so nothing can be listed as the document beside it. The name you type when renaming, the tooltip on a trimmed name and the look-alike mark all keep the whole file name, and a shortcut or a launcher keeps the name it already had."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="Spacing"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <Grid ColumnDefinitions="*,90">
            <TextBlock Grid.Column="0" Text="Extra gap between grid tiles (px)"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            <TextBox Grid.Column="1" Text="{Binding IconSpacing}"
                     PlaceholderText="None"
                     FontSize="{DynamicResource FontSizeSmall}"/>
          </Grid>

          <Grid ColumnDefinitions="*,90">
            <TextBlock Grid.Column="0" Text="Extra gap around compact cells (px)"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            <TextBox Grid.Column="1" Text="{Binding CompactSpacing}"
                     PlaceholderText="None"
                     FontSize="{DynamicResource FontSizeSmall}"/>
          </Grid>

          <TextBlock Text="Blank or 0 leaves the layouts as they are. The value scales with the icon size, so a grid stays proportioned when you zoom. Capped at 48."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <!-- The layout is "List" on the toolbar button and in the README; this
               heading was the only place calling it the details view, three
               sections under a "Details panel" heading that means something else
               again. The panel keeps its name — it really is the details — and
               the layout takes the one the rest of the interface already uses. -->
          <TextBlock Text="List view"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding AbsoluteDates}">
              <StackPanel>
                <TextBlock Text="Absolute dates"/>
                <TextBlock Text="2026-07-26 14:30 for everything, instead of dropping the parts you can infer from today."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>

            <CheckBox Content="Show item counts for folders"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding ShowFolderItemCounts}"/>
          </StackPanel>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Navigation">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Open files and folders with"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="6">
            <RadioButton GroupName="activation"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding OpenWithSystem}">
              <StackPanel>
                <TextBlock Text="Whatever the desktop is set to"/>
                <TextBlock Text="Follows your desktop's own single-click setting, so it matches the rest of your system without being configured twice."
                           FontSize="{DynamicResource FontSizeTiny}"
                           Foreground="{DynamicResource ViewDimText}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </RadioButton>

            <RadioButton Content="A single click" GroupName="activation"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding OpenWithSingle}"/>

            <RadioButton Content="A double click" GroupName="activation"
                         FontSize="{DynamicResource FontSizeSmall}"
                         IsChecked="{Binding OpenWithDouble}"/>
          </StackPanel>

          <TextBlock Text="Takes effect immediately — the setting is read when you click, not when a row is drawn."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

          <TextBlock Text="Backspace"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <!-- **Backspace answered Explorer's habit and nobody else's.** It went
               Back through history full stop, so somebody who learned the key in
               Dolphin — where it goes to the parent folder — pressed it at the
               bottom of a deep tree and was thrown to wherever they had been ten
               minutes ago.

               Asked as the Dolphin question so that unticked is what shipped, and
               so that the stored value's zero is the shipped behaviour too: a key
               absent from a settings.json written before this existed comes back
               as false, and false has to mean Back. -->
          <CheckBox x:Name="BackspaceChoice"
                    FontSize="{DynamicResource FontSizeSmall}"
                    IsChecked="{Binding BackspaceGoesUp}">
            <StackPanel>
              <TextBlock Text="Backspace goes up one folder"/>
              <TextBlock Text="Off, Backspace goes back through the folders you visited, the way Explorer does. On, it goes up to the parent folder, the way Dolphin does. Alt+Left and Alt+Up keep doing those two jobs either way, and F1 says which one Backspace is currently doing. Where there is no parent — This PC, the bin, Recent, a search — it then does nothing."
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Context menu">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="Show these in the right-click menu"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Copy to" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuCopyTo}"/>
            <CheckBox Content="Move to" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuMoveTo}"/>
            <CheckBox Content="Open in new tab" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuOpenInNewTab}"/>
            <CheckBox Content="Open in new window" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuOpenInNewWindow}"/>
            <CheckBox Content="Add to places" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuAddToPlaces}"/>
            <CheckBox Content="Copy as path" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuCopyLocation}"/>
            <CheckBox Content="Duplicate" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuDuplicate}"/>
            <!-- **Named for what it hides, which is now all three parts of
                 Arrange.** Sort by and Group by were folded into one submenu and
                 this gate moved up onto the parent, so as "Sort by" the label
                 understated it by half and left people wondering where grouping
                 had gone; Columns then joined them, because the chooser had no
                 home a keyboard could reach, and the label understated it again.
                 MenuSortBy stays MenuSortBy: it is the key the setting is stored
                 under, and renaming it would silently reset the preference on
                 every install that already has one. -->
            <CheckBox Content="Arrange (sort, group and columns)" FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding MenuSortBy}"/>
          </StackPanel>

          <!-- **The old wording promised "its keyboard shortcut still works",
               and for almost everything on this list there is no such shortcut.**
               Neither Window.KeyBindings nor the code-behind key handler binds
               Copy to, Move to, Open in new tab, Add selection to places, Copy
               location, Duplicate or any sort command — hide one of those and it
               is gone until the box is ticked again.

               The two exceptions are named rather than rounded away, because a
               note that undersells is the same defect in the other direction.
               Add to places gates two entries, and the second of them is Ctrl+D
               — PinCurrentCommand, the folder you are in, not the selection —
               which is a real binding and goes on working while the entries are
               hidden. Arrange keeps two of its three parts through the list
               view's column headers: left-clicking one sorts by it, and
               right-clicking them opens the same column chooser Arrange holds.

               **In Details, and only there. The band those headings live in
               carries IsVisible="{Binding IsDetailsView}" and the menu's Sort
               by carries no gate at all**, so in Grid and Compact there is
               nothing to click and hiding Arrange takes sorting away along with
               grouping — it is the grouping half alone only in the layout that
               draws columns. The sentence below is scoped to "the list view's
               column headers" for that reason and is true as it stands;
               Hiding_arrange_leaves_the_headings_only_in_details is what keeps
               the escape route and this claim about it together, because the
               route is a control in another file.

               Adding the missing gestures instead, so the original sentence
               came true, was rejected here: the bindings live in MainWindow and
               need free keys chosen for each, and until that happens this page
               would still be the thing telling the lie. -->
          <TextBlock Text="Hiding an entry takes it off the menu without removing the command — but for most of these the menu is the only route. Ctrl+D still adds the current folder to places while Add to places is hidden. While Arrange is hidden, the list view's column headers still sort by name, type, size or modified, and right-clicking those headers still chooses which columns to show. Copy as path still works on ctrl+shift+c. Nothing else here has a shortcut."
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding BinTitle}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource AppBackground}">
        <StackPanel Spacing="14" Margin="20,16,20,16">

          <TextBlock Text="This deletes files permanently, on its own, while Vaktari is running. Both options are off unless you turn them on."
                     FontSize="{DynamicResource FontSizeSmall}"
                     TextWrapping="Wrap"/>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="Delete items after a number of days"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding DeleteOldTrash}"/>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetTrashAge}">
              <TextBlock Grid.Column="0" Text="Days to keep"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding DeleteAfterDays}"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <StackPanel Spacing="8">
            <CheckBox Content="{Binding LimitBinLabel}"
                      FontSize="{DynamicResource FontSizeSmall}"
                      IsChecked="{Binding LimitTrashSize}"/>

            <Grid ColumnDefinitions="*,90" Margin="24,0,0,0"
                  IsEnabled="{Binding CanSetTrashSize}">
              <TextBlock Grid.Column="0" Text="Percent of the disk"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSmall}"/>
              <TextBox Grid.Column="1" Text="{Binding MaxPercentOfDisk}"
                       FontSize="{DynamicResource FontSizeSmall}"/>
            </Grid>

            <StackPanel Spacing="6" Margin="24,0,0,0"
                        IsEnabled="{Binding CanSetTrashSize}">
              <TextBlock Text="When it is exceeded"
                         FontSize="{DynamicResource FontSizeTiny}"
                         Foreground="{DynamicResource ViewDimText}"/>

              <RadioButton Content="Just say so" GroupName="trashlimit"
                           FontSize="{DynamicResource FontSizeSmall}"
                           IsChecked="{Binding LimitActionWarn}"/>
              <RadioButton Content="Delete the oldest until it fits" GroupName="trashlimit"
                           FontSize="{DynamicResource FontSizeSmall}"
                           IsChecked="{Binding LimitActionOldest}"/>
              <RadioButton Content="Delete the largest until it fits" GroupName="trashlimit"
                           FontSize="{DynamicResource FontSizeSmall}"
                           IsChecked="{Binding LimitActionLargest}"/>
            </StackPanel>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SeparatorColour}"/>

          <TextBlock Text="{Binding BinSweepExplanation}"
                     FontSize="{DynamicResource FontSizeTiny}"
                     Foreground="{DynamicResource ViewDimText}"
                     TextWrapping="Wrap"/>

        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
