<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vaktari.Windows</RootNamespace>
    <!-- LibraryImport generates unsafe marshalling code. Vaktari.Linux sets
         this for the same reason. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Plain net10.0, not net10.0-windows, and that is a decision rather than an
       oversight. SupportedOSPlatform on the assembly already satisfies the
       platform analyser, and a single TFM keeps the solution buildable on Linux
       so CI compile-checks this project on every push. Revisit when something
       here actually needs the Windows-only BCL surface — the registry reads for
       IThemeProvider are the first candidate. -->

  <ItemGroup>
    <ProjectReference Include="..\Vaktari.Core\Vaktari.Core.csproj" />
  </ItemGroup>


  <!-- The Recycle Bin's purge is reached only through a sweep or an Empty, and
       the state worth testing — a recycled payload holding a read-only file —
       cannot be arranged through the public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vaktari.Windows.Tests" />
  </ItemGroup>

</Project>
