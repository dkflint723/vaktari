<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- Same reasoning as the other test projects: Directory.Build.props turns
         on the trim, AOT and single-file analysers for the shipped binary, and
         a test host is not shipped. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- The headless platform draws into a bitmap rather than onto a screen, so
         this runs on a CI box with no display. That is the point: the layer
         holding most of this application had no tests because everything in it
         needs a Window.

         Exe, not Library: xunit v3 test projects are executables that host
         their own runner. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- **xunit v3 here, v2 in the other two test projects.**
       Avalonia.Headless.XUnit 12.1 is built against v3, and the two versions
       cannot coexist in ONE assembly — every [InlineData] resolves ambiguously.
       Across separate assemblies they are fine, and `dotnet test` runs both.
       Upgrading the other projects for uniformity would be churn in tests that
       work, for no benefit beyond matching version numbers. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
    <!-- Loads a binding expression at runtime, so the one form the row
         templates depend on can be proved rather than assumed. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vaktari.Ui/Vaktari.Ui.csproj" />
    <ProjectReference Include="../../src/Vaktari.Core/Vaktari.Core.csproj" />
  </ItemGroup>

  <!-- The window's markup, embedded so MarkupRulesTests reads the real file
       rather than hunting for it relative to a test host's working directory.
       Re-embedded on every build, so it cannot drift from what ships. -->
  <ItemGroup>
    <EmbeddedResource Include="../../src/Vaktari.Ui/MainWindow.axaml" LogicalName="MainWindow.axaml" />
  </ItemGroup>

</Project>
