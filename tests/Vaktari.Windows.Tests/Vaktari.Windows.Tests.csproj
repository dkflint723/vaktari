<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- See Vaktari.Core.Tests for why the published-binary analysers are off
         here: xunit and the test host use reflection by design, and with
         TreatWarningsAsErrors inherited they would fail a build over code that
         never ships. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Plain net10.0, matching Vaktari.Windows itself, so this project still
       compiles on Linux and CI keeps compile-checking it on every push. The
       tests all skip there — see the WindowsFact attribute — but a Windows-only
       TFM would hide a broken build until someone opened it on Windows. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vaktari.Windows/Vaktari.Windows.csproj" />
  </ItemGroup>

  <!-- Linked rather than copied. The attribute pair carries a skip reason that
       has to stay identical wherever it is used, and PlatformFacts.cs says as
       much about the pair inside it — a second copy in this project would be
       the same drift one directory further out. -->
  <ItemGroup>
    <Compile Include="../Vaktari.Core.Tests/PlatformFacts.cs" Link="PlatformFacts.cs" />
    <Compile Include="../Vaktari.Core.Tests/LargeFixture.cs" Link="LargeFixture.cs" />
  </ItemGroup>

</Project>
