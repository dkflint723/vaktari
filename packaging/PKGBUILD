# Maintainer: Flint <noreply@users.noreply.github.com>
#
# NOTE ON THE NAME: this package was `vaktari-fm` when the project was called
# Heimdall, because `heimdall` is taken in Arch's repositories by the Samsung
# firmware flashing tool. That reason left with the rename — `vaktari` is free —
# so the suffix is gone and the old name is superseded below.
#
# The rename sweep rewrote this note mechanically and left it claiming that
# `vaktari` was the taken one, which is exactly backwards. Check before
# publishing rather than trusting a comment:  pacman -Ss '^vaktari$'
#
# Unlike the RPM, this builds FROM SOURCE — that is the Arch convention, and the
# AUR expects a PKGBUILD that a user's own machine can compile.

pkgname=vaktari
_projname=vaktari
# Supersedes the package this was before the rename, so `pacman -Syu` replaces
# it instead of leaving two file managers installed over each other.
replaces=('heimdall-fm')
conflicts=('heimdall-fm')

pkgver=0.11.0
pkgrel=1
pkgdesc="A file manager for KDE that consumes the desktop instead of reimplementing it"
arch=('x86_64')
url="https://github.com/dkflint723/vaktari"
license=('MIT')

# Loaded at runtime by the bundled SkiaSharp, and by the desktop integration.
depends=('fontconfig' 'glib2' 'shared-mime-info' 'xdg-utils')

# NativeAOT links with clang and needs zlib's headers.
makedepends=('dotnet-sdk' 'clang' 'zlib')

# Each turns a feature on; the application runs without them.
optdepends=('git: version-control decorations'
            'avahi: network share discovery'
            'copyparty: file sharing over HTTP')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # replace with the real digest before publishing to the AUR

build() {
    cd "$srcdir/$_projname-$pkgver"

    # InvariantGlobalization is already set in Directory.Build.props, so the
    # result needs no ICU at runtime.
    dotnet publish src/Vaktari.Ui \
        -c Release \
        -r linux-x64 \
        -p:PublishAot=true
}

package() {
    cd "$srcdir/$_projname-$pkgver"
    local publish="src/Vaktari.Ui/bin/Release/net10.0/linux-x64/publish"

    # The whole directory travels together: libSkiaSharp.so and
    # libHarfBuzzSharp.so are loaded from the binary's own directory, so
    # installing the executable alone gives a program that aborts at startup.
    install -d "$pkgdir/usr/lib/$_projname"
    cp -a "$publish"/Vaktari.Ui "$publish"/*.so "$pkgdir/usr/lib/$_projname/"

    install -d "$pkgdir/usr/bin"
    ln -s "/usr/lib/$_projname/Vaktari.Ui" "$pkgdir/usr/bin/$_projname"

    install -Dm644 brand/vaktari.desktop \
        "$pkgdir/usr/share/applications/$_projname.desktop"

    for size in 16 24 48; do
        install -Dm644 "brand/icons/hicolor/${size}x${size}/apps/vaktari.svg" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$_projname.svg"
    done
    install -Dm644 brand/icons/hicolor/scalable/apps/vaktari.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_projname.svg"

    # The symbolic variant, which this package was silently dropping while the
    # RPM shipped it. A dark panel or a monochrome menu wants the single-colour
    # glyph, not the full-colour plate. The theme resolves it by the
    # `-symbolic` filename suffix, not by the directory alone.
    install -Dm644 brand/icons/hicolor/symbolic/apps/vaktari-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/$_projname-symbolic.svg"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # The notices for the components the binary carries, which this package
    # was leaving behind while the tarball, the installer and the RPM all
    # shipped them. Their licences ask for each notice to travel with every
    # copy, and the README promises them inside every package. Beside LICENSE,
    # because that is where Arch keeps a package's licence texts.
    install -Dm644 THIRD-PARTY-NOTICES.txt \
        "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
